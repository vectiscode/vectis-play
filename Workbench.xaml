<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vectis Play" Width="980" Height="680" MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="#000000" Foreground="#F5F5F5" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <!-- Palette: black surfaces, neutral gray borders and white primary actions -->
    <SolidColorBrush x:Key="Ink" Color="#000000"/>
    <SolidColorBrush x:Key="Rail" Color="#050505"/>
    <SolidColorBrush x:Key="Panel" Color="#0B0B0B"/>
    <SolidColorBrush x:Key="Field" Color="#080808"/>
    <SolidColorBrush x:Key="Raised" Color="#141414"/>
    <SolidColorBrush x:Key="Line" Color="#242424"/>
    <SolidColorBrush x:Key="Line2" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="Paper" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="Muted" Color="#A0A0A0"/>
    <SolidColorBrush x:Key="Signal" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="SignalDeep" Color="#CFCFCF"/>
    <SolidColorBrush x:Key="SignalInk" Color="#000000"/>
    <SolidColorBrush x:Key="SignalWash" Color="#1B1B1B"/>
    <SolidColorBrush x:Key="FocusRing" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FocusHalo" Color="#40FFFFFF"/>
    <FontFamily x:Key="Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Mono">Segoe UI Variable Text, Segoe UI</FontFamily>

    <!-- Text roles -->
    <Style x:Key="Eyebrow" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    </Style>
    <Style x:Key="PageTitle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Display}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="30"/>
      <Setter Property="Foreground" Value="{StaticResource Paper}"/>
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Display}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="19"/>
      <Setter Property="Foreground" Value="{StaticResource Paper}"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Panel}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="28,24"/>
      <Style.Triggers>
        <EventTrigger RoutedEvent="Loaded">
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.35" To="1" Duration="0:0:0.28">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
              </DoubleAnimation>
            </Storyboard>
          </BeginStoryboard>
        </EventTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Tile" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Field}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="Margin" Value="0,0,10,10"/>
    </Style>
    <Style x:Key="TileLabel" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    </Style>
    <Style x:Key="TileValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Paper}"/>
      <Setter Property="Margin" Value="0,4,0,0"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Paper}"/>
    </Style>
    <Style x:Key="FieldHint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="18"/>
      <Setter Property="Margin" Value="0,3,24,0"/>
    </Style>
    <Style x:Key="Unit" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>
    <Style x:Key="Margin" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="19"/>
    </Style>

    <!-- Page frame: one scroll view per page, content centered with a readable max width -->
    <Style x:Key="PageScroll" TargetType="ScrollViewer">
      <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="PanningMode" Value="VerticalOnly"/>
    </Style>
    <Style x:Key="Page" TargetType="StackPanel">
      <Setter Property="Margin" Value="32,24,32,24"/>
      <Setter Property="MaxWidth" Value="780"/>
    </Style>

    <!-- Buttons: ghost by default, Accent for the one primary action. Focus draws a ring plus a coral halo -->
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Paper}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="MinWidth" Value="112"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Halo" Margin="-3" CornerRadius="9" BorderThickness="1" BorderBrush="{StaticResource FocusHalo}" Visibility="Hidden"/>
              <Border x:Name="Face" CornerRadius="7" Background="{StaticResource Raised}" BorderBrush="{StaticResource Line2}" BorderThickness="1" Padding="18,0" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><ScaleTransform x:Name="FaceScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="FaceScale" Storyboard.TargetProperty="ScaleX" To="1.012" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                  <DoubleAnimation Storyboard.TargetName="FaceScale" Storyboard.TargetProperty="ScaleY" To="1.012" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                </Storyboard></BeginStoryboard>
              </EventTrigger>
              <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="FaceScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                  <DoubleAnimation Storyboard.TargetName="FaceScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                </Storyboard></BeginStoryboard>
              </EventTrigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#1C1C1C"/><Setter TargetName="Face" Property="BorderBrush" Value="#555555"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Background" Value="#050505"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource FocusRing}"/>
                <Setter TargetName="Face" Property="BorderThickness" Value="2"/>
                <Setter TargetName="Face" Property="Padding" Value="17,0"/>
                <Setter TargetName="Halo" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Face" Property="Opacity" Value="0.4"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Accent" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="{StaticResource SignalInk}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Halo" Margin="-3" CornerRadius="9" BorderThickness="1" BorderBrush="#80FFFFFF" Visibility="Hidden"/>
              <Border x:Name="Face" CornerRadius="7" BorderThickness="0" Padding="20,0" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><ScaleTransform x:Name="FaceScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFFFFF" Offset="0"/>
                    <GradientStop Color="#E8E8E8" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="FaceScale" Storyboard.TargetProperty="ScaleX" To="1.018" Duration="0:0:0.16"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                  <DoubleAnimation Storyboard.TargetName="FaceScale" Storyboard.TargetProperty="ScaleY" To="1.018" Duration="0:0:0.16"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                </Storyboard></BeginStoryboard>
              </EventTrigger>
              <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="FaceScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                  <DoubleAnimation Storyboard.TargetName="FaceScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                </Storyboard></BeginStoryboard>
              </EventTrigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#FFFFFF"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Background" Value="#BDBDBD"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Halo" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                <Setter TargetName="Face" Property="Background" Value="{StaticResource Raised}"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Accent outline: signal border and text on transparent, for secondary accent actions -->
    <Style x:Key="SignalOutline" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="{StaticResource Signal}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Halo" Margin="-3" CornerRadius="9" BorderThickness="1" BorderBrush="{StaticResource FocusHalo}" Visibility="Hidden"/>
              <Border x:Name="Face" CornerRadius="7" Background="Transparent" BorderBrush="{StaticResource Signal}" BorderThickness="1.5" Padding="18,0">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="{StaticResource SignalWash}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Background" Value="#0A0A0A"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource FocusRing}"/>
                <Setter TargetName="Face" Property="BorderThickness" Value="2"/>
                <Setter TargetName="Face" Property="Background" Value="{StaticResource SignalWash}"/>
                <Setter TargetName="Halo" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value="0.4"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- TextBox -->
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource Paper}"/>
      <Setter Property="CaretBrush" Value="{StaticResource Signal}"/>
      <Setter Property="SelectionBrush" Value="{StaticResource Signal}"/>
      <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Grid>
              <Border x:Name="Halo" Margin="-3" CornerRadius="9" BorderThickness="1" BorderBrush="{StaticResource FocusHalo}" Visibility="Hidden"/>
              <Border x:Name="Frame" Background="{StaticResource Field}" BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="7">
                <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#555555"/></Trigger>
              <Trigger Property="Tag" Value="changed"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Signal}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource FocusRing}"/>
                <Setter TargetName="Frame" Property="BorderThickness" Value="2"/>
                <Setter TargetName="Frame" Property="Background" Value="#101010"/>
                <Setter TargetName="Halo" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ComboBox -->
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Paper}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Row" Height="42" Padding="14,0" Margin="4,1" CornerRadius="5" Background="Transparent" BorderThickness="0">
              <Grid>
                <Border x:Name="Bar" Width="3" Height="18" HorizontalAlignment="Left" Margin="-8,0,0,0" CornerRadius="1.5" Background="{StaticResource Signal}" Visibility="Hidden"/>
                <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Row" Property="Background" Value="#161616"/>
              </Trigger>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="#242424"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource Paper}"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="MaxDropDownHeight" Value="320"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <Border x:Name="Halo" Margin="-3" CornerRadius="9" BorderThickness="1" BorderBrush="{StaticResource FocusHalo}" Visibility="Hidden"/>
              <Border x:Name="Frame" Background="{StaticResource Field}" BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="7"/>
              <ToggleButton Focusable="False" ClickMode="Press" Background="Transparent" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                      <Path x:Name="Chevron" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" Data="M0 0L6 6L12 0" Stroke="{StaticResource Muted}" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Stroke" Value="{StaticResource Signal}"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter IsHitTestVisible="False" Margin="14,0,40,0" VerticalAlignment="Center" HorizontalAlignment="Left" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" TextElement.Foreground="{TemplateBinding Foreground}"/>
              <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade" IsOpen="{TemplateBinding IsDropDownOpen}">
                <Border MinWidth="{Binding ActualWidth, ElementName=Frame}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,4,12,14" Padding="0,4" Background="#0D0D0D" BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="8" SnapsToDevicePixels="True">
                  <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="5" Opacity="0.6" Color="#000000"/></Border.Effect>
                  <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#555555"/></Trigger>
              <Trigger Property="Tag" Value="changed"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Signal}"/></Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource FocusRing}"/>
                <Setter TargetName="Frame" Property="BorderThickness" Value="2"/>
                <Setter TargetName="Frame" Property="Background" Value="#101010"/>
                <Setter TargetName="Halo" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45"/><Setter Property="Opacity" Value="0.6"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- CheckBox drawn as a switch: every on/off setting reads the same way -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Paper}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid VerticalAlignment="Center">
                <Border x:Name="Halo" Margin="-4" CornerRadius="17" BorderThickness="2" BorderBrush="{StaticResource FocusHalo}" Visibility="Hidden"/>
                <Border x:Name="Track" Width="50" Height="28" CornerRadius="14" Background="{StaticResource Field}" BorderBrush="{StaticResource Line2}" BorderThickness="1.5">
                  <Ellipse x:Name="Knob" Width="18" Height="18" HorizontalAlignment="Left" Margin="4,0,0,0" Fill="{StaticResource Muted}"/>
                </Border>
              </Grid>
              <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{StaticResource Signal}"/>
                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Signal}"/>
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0"/>
                <Setter TargetName="Knob" Property="Fill" Value="{StaticResource SignalInk}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#555555"/></Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsChecked" Value="True"/></MultiTrigger.Conditions>
                <Setter TargetName="Track" Property="Background" Value="#E8E8E8"/>
                <Setter TargetName="Track" Property="BorderBrush" Value="#E8E8E8"/>
              </MultiTrigger>
              <Trigger Property="Tag" Value="changed"><Setter TargetName="Halo" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource FocusRing}"/>
                <Setter TargetName="Halo" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Halo" Property="BorderBrush" Value="{StaticResource FocusRing}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Slider: 6px track, signal fill up to a large thumb, halo on keyboard focus -->
    <Style TargetType="Slider">
      <Setter Property="Height" Value="36"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Background="Transparent">
              <Border x:Name="Rail" Height="6" VerticalAlignment="Center" Margin="11,0" Background="{StaticResource Line2}" CornerRadius="3"/>
              <Track x:Name="PART_Track" IsDirectionReversed="False">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" IsTabStop="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent"><Border Height="6" VerticalAlignment="Center" Margin="11,0,-11,0" Background="{StaticResource Signal}" CornerRadius="3"/></Grid>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" IsTabStop="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Grid Width="34" Height="34" Background="Transparent">
                          <Ellipse x:Name="Halo" Width="34" Height="34" Stroke="{StaticResource FocusHalo}" StrokeThickness="2" Visibility="Hidden"/>
                          <Ellipse x:Name="Knob" Width="22" Height="22" Fill="{StaticResource Paper}" Stroke="{StaticResource Signal}" StrokeThickness="2"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Knob" Property="Fill" Value="#FFFFFF"/></Trigger>
                          <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=Slider}}" Value="True">
                            <Setter TargetName="Knob" Property="Stroke" Value="{StaticResource FocusRing}"/>
                            <Setter TargetName="Knob" Property="StrokeThickness" Value="3"/>
                            <Setter TargetName="Halo" Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Rail" Property="Background" Value="#555555"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Slim vertical scrollbar -->
    <Style x:Key="PageButton" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="12"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent" Margin="0,6">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource PageButton}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource PageButton}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bar" Margin="3,0" Background="#2C2C2C" CornerRadius="3"/>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bar" Property="Background" Value="#4A4A4A"/></Trigger>
                          <Trigger Property="IsDragging" Value="True"><Setter TargetName="Bar" Property="Background" Value="{StaticResource Signal}"/></Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Left rail: TabControl restyled as a sidebar, brand mark inside the template -->
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontFamily" Value="{StaticResource Display}"/>
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Grid Height="52" Margin="12,2">
              <Border x:Name="Row" CornerRadius="8" Background="Transparent" BorderThickness="2" BorderBrush="Transparent"/>
              <Border x:Name="Bar" Width="4" Height="22" HorizontalAlignment="Left" Margin="0" CornerRadius="2" Background="{StaticResource Signal}" Visibility="Hidden"/>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
              </StackPanel>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#101010"/></Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Row" Property="Background" Value="#181818"/>
                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource FocusRing}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{StaticResource Paper}"/></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Paper}"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="TabControl">
      <Setter Property="Background" Value="{StaticResource Ink}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="204"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Background="{StaticResource Rail}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="False">
                  <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="26,28,0,28">
                    <Viewbox Width="32" Height="32" Stretch="Uniform">
                      <Canvas Width="760" Height="760">
                        <Canvas.RenderTransform><TranslateTransform X="-118" Y="-192"/></Canvas.RenderTransform>
                        <Path Fill="#F5F5F5" Data="M143 210H335C398 210 438 248 458 322C492 450 532 680 566 830L518 935Z"/>
                        <Path Fill="#D1281F" Data="M680 210H853L566 830C546 750 544 610 562 470C580 330 606 210 680 210Z"/>
                        <Path Fill="#99251E" Data="M853 210C730 340 600 500 558 720L566 830Z"/>
                      </Canvas>
                    </Viewbox>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="Vectis Play" FontFamily="{StaticResource Display}" FontWeight="SemiBold" FontSize="21" Foreground="{StaticResource Paper}"/>
                      <TextBlock Text="PS5 REMOTE PLAY" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                  </StackPanel>
                  <StackPanel IsItemsHost="True" DockPanel.Dock="Top" KeyboardNavigation.TabNavigation="Once"/>
                </DockPanel>
              </Border>
              <ContentPresenter Grid.Column="1" ContentSource="SelectedContent" Margin="0,0,0,72"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <TabControl x:Name="Pages" TabStripPlacement="Left">

      <!-- 01 HOME -->
      <TabItem x:Name="SessionTab" Header="Home" Tag="01">
        <ScrollViewer Style="{StaticResource PageScroll}">
          <StackPanel Style="{StaticResource Page}">

            <!-- Hero: console, state and the one dominant action -->
            <Border Padding="2,18,2,26" Margin="0,0,0,2" BorderThickness="0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                  <Border Background="{StaticResource SignalWash}" CornerRadius="13" Padding="10,4,12,4" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                      <Ellipse Width="8" Height="8" Fill="{StaticResource Signal}" VerticalAlignment="Center"/>
                      <TextBlock x:Name="SessionState" Text="READY" Margin="8,0,0,0" FontFamily="{StaticResource Mono}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Signal}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Border>
                  <TextBlock x:Name="SessionTitle" Style="{StaticResource PageTitle}" FontSize="44" Text="Pair your PS5" Margin="0,12,0,6" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                  <TextBlock x:Name="SessionDetail" Style="{StaticResource Margin}" Text="Keep the console awake on the same network as this PC."/>
                  <ComboBox x:Name="ConsoleList" Visibility="Collapsed" Margin="0,14,0,0" MaxWidth="360" HorizontalAlignment="Stretch" AutomationProperties.Name="Console"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Width="268" VerticalAlignment="Center">
                  <Button x:Name="Primary" Style="{StaticResource Accent}" Content="Pair PS5" Height="56" FontSize="18" FontFamily="{StaticResource Display}" MinWidth="0" AutomationProperties.Name="Connect"/>
                  <DockPanel Margin="0,10,0,0" LastChildFill="True">
                    <Button x:Name="Manage" DockPanel.Dock="Left" Content="Consoles" Visibility="Collapsed" Width="129" MinWidth="0" Margin="0,0,10,0" ToolTip="Pair another PS5 or manage paired consoles" AutomationProperties.Name="Pair or manage consoles"/>
                    <Button x:Name="NativeSettings" Content="Controller" MinWidth="0" ToolTip="Open the player's own settings for controller mapping and extra options" AutomationProperties.Name="Controller settings"/>
                  </DockPanel>
                </StackPanel>
              </Grid>
            </Border>

            <!-- Simple mode: the few choices most players need -->
            <Border x:Name="QuickSetupCard" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="24,18,24,20">
              <StackPanel>
                <DockPanel Margin="0,0,0,12">
                  <TextBlock Style="{StaticResource CardTitle}" Text="Quick setup" VerticalAlignment="Center"/>
                </DockPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                  <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Performance" Height="28" Padding="0,4,0,0" ToolTip="All presets keep vertical sync off for lower latency and use direct frame mapping. Balanced is the everyday choice. Cinema adds the highest bitrate plus neural network upscaling for sharper detail on high resolution screens."/>
                    <ComboBox x:Name="PerformancePreset" Margin="0,6,0,0" AutomationProperties.Name="Performance preset"/>
                  </StackPanel>
                  <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Picture" Height="28" Padding="0,4,0,0" ToolTip="Sharper video needs more bandwidth. Optional 10-bit HDR is in All settings, Stream, Codec."/>
                    <ComboBox x:Name="SimpleQuality" Margin="0,6,0,0" AutomationProperties.Name="Picture quality preset"/>
                  </StackPanel>

                  <StackPanel Grid.Row="2" Grid.Column="0">
                    <DockPanel Height="28">
                      <CheckBox x:Name="SimpleMouseAim" DockPanel.Dock="Right" MinHeight="28" VerticalAlignment="Center" AutomationProperties.Name="Use the mouse to aim" ToolTip="Mouse movement steers the right stick"/>
                      <TextBlock Style="{StaticResource FieldLabel}" Text="Mouse aim" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Grid Margin="0,6,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <TextBox x:Name="SimpleAimSensitivity" AutomationProperties.Name="Simple aim sensitivity" ToolTip="Aim sensitivity"/>
                      <Slider x:Name="SimpleAimSensitivitySlider" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Minimum="0.1" Maximum="10" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding Text, ElementName=SimpleAimSensitivity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled, ElementName=SimpleAimSensitivity}" AutomationProperties.Name="Simple sensitivity slider"/>
                    </Grid>
                  </StackPanel>
                  <StackPanel Grid.Row="2" Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Volume" Height="28" Padding="0,4,0,0"/>
                    <Grid Margin="0,6,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <Grid>
                        <TextBox x:Name="SimpleVolume" Padding="12,0,28,0" AutomationProperties.Name="Simple audio volume percent"/>
                        <TextBlock Style="{StaticResource Unit}" Text="%" HorizontalAlignment="Right" Margin="0,0,12,0"/>
                      </Grid>
                      <Slider x:Name="SimpleVolumeSlider" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Text, ElementName=SimpleVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled, ElementName=SimpleVolume}" AutomationProperties.Name="Simple volume slider"/>
                    </Grid>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <!-- Advanced mode: read-only summary of the saved detailed profile -->
            <Border x:Name="AdvancedSummary" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="24,18,14,10" Visibility="Collapsed">
              <StackPanel>
                <DockPanel Margin="0,0,10,12">
                  <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldHint}" Margin="16,0,0,0" VerticalAlignment="Center" Text="Saved values. Edit them in the pages on the left."/>
                  <TextBlock Style="{StaticResource CardTitle}" Text="Stream profile" VerticalAlignment="Center"/>
                </DockPanel>
                <UniformGrid Columns="3">
                  <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Style="{StaticResource TileLabel}" Text="RESOLUTION"/><TextBlock x:Name="SumResolution" Style="{StaticResource TileValue}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></StackPanel></Border>
                  <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Style="{StaticResource TileLabel}" Text="FRAME RATE"/><TextBlock x:Name="SumRate" Style="{StaticResource TileValue}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></StackPanel></Border>
                  <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Style="{StaticResource TileLabel}" Text="BITRATE"/><TextBlock x:Name="SumBitrate" Style="{StaticResource TileValue}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></StackPanel></Border>
                  <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Style="{StaticResource TileLabel}" Text="DECODER"/><TextBlock x:Name="SumDecoder" Style="{StaticResource TileValue}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></StackPanel></Border>
                  <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Style="{StaticResource TileLabel}" Text="SCALING"/><TextBlock x:Name="SumScaling" Style="{StaticResource TileValue}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></StackPanel></Border>
                  <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Style="{StaticResource TileLabel}" Text="AUDIO BUFFER"/><TextBlock x:Name="SumBuffer" Style="{StaticResource TileValue}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></StackPanel></Border>
                </UniformGrid>
              </StackPanel>
            </Border>

            <!-- Network check: one line until a check runs, details below -->
            <Border Margin="0,8,0,0" Padding="2,8" BorderThickness="0">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource CardTitle}" Text="Network check"/>
                    <TextBlock Style="{StaticResource FieldHint}" Margin="0,2,16,0" Text="10 seconds between this PC and your router. The PS5 is not contacted."/>
                  </StackPanel>
                  <Button x:Name="CheckLink" Grid.Column="1" Style="{StaticResource SignalOutline}" Content="Check my network" VerticalAlignment="Center" MinWidth="176"/>
                </Grid>
                <StackPanel x:Name="LinkDetails" Visibility="Collapsed" Margin="0,16,0,0">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" MinWidth="240"/>
                      <ColumnDefinition Width="256"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource Field}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Height="150" ClipToBounds="True">
                      <Canvas x:Name="LinkTrace"/>
                    </Border>
                    <UniformGrid Grid.Column="1" Columns="2" Rows="3" Margin="18,0,0,0">
                      <StackPanel Margin="0,0,12,10">
                        <TextBlock Style="{StaticResource TileLabel}" FontSize="10" Text="CONNECTION"/>
                        <TextBlock x:Name="LinkKind" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Paper}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                      </StackPanel>
                      <StackPanel Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource TileLabel}" FontSize="10" Text="WI-FI SIGNAL"/>
                        <TextBlock x:Name="LinkSignal" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Paper}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                      </StackPanel>
                      <StackPanel Margin="0,0,12,10">
                        <TextBlock Style="{StaticResource TileLabel}" FontSize="10" Text="ADAPTER SPEED"/>
                        <TextBlock x:Name="LinkReceive" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Paper}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="The negotiated receive rate of the network adapter, not an internet speed test."/>
                      </StackPanel>
                      <StackPanel Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource TileLabel}" FontSize="10" Text="TYPICAL DELAY"/>
                        <TextBlock x:Name="LinkMedian" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Paper}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="Half of the router replies were faster than this and half were slower."/>
                      </StackPanel>
                      <StackPanel Margin="0,0,12,0">
                        <TextBlock Style="{StaticResource TileLabel}" FontSize="10" Text="HIGH DELAY"/>
                        <TextBlock x:Name="LinkP95" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Paper}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="95 percent of router replies were at or below this delay."/>
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Style="{StaticResource TileLabel}" FontSize="10" Text="SPIKES + LOSS"/>
                        <TextBlock x:Name="LinkSpikes" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Paper}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="How many delay spikes were seen and how many replies were missing."/>
                      </StackPanel>
                    </UniformGrid>
                  </Grid>
                  <TextBlock x:Name="LinkNotes" Style="{StaticResource FieldHint}" Margin="0,12,0,0"/>
                  <Button x:Name="UseLinkBitrate" Style="{StaticResource SignalOutline}" Content="Use suggested bitrate" Visibility="Collapsed" MinWidth="176" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- 02 STREAM -->
      <TabItem x:Name="StreamTab" Header="Stream" Tag="02">
        <ScrollViewer Style="{StaticResource PageScroll}">
          <StackPanel Style="{StaticResource Page}">
            <Grid Margin="0,4,0,20">
              <StackPanel>
                <TextBlock Style="{StaticResource Eyebrow}" Text="STREAM"/>
                <TextBlock Style="{StaticResource PageTitle}" Text="Picture size and bandwidth" Margin="0,2,0,0"/>
              </StackPanel>
            </Grid>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource Eyebrow}" Text="STREAM SETTINGS"/>
                <TextBlock Style="{StaticResource CardTitle}" Text="Console video" Margin="0,2,0,4"/>
                <TextBlock Style="{StaticResource FieldHint}" Margin="0,0,0,16" Text="These choices decide how much picture data the PS5 sends."/>
                <Grid Margin="0,0,0,22">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Resolution"/><TextBlock Style="{StaticResource FieldHint}" Text="Higher resolutions look sharper and need more network bandwidth."/></StackPanel>
                  <ComboBox x:Name="Resolution" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Top" AutomationProperties.Name="Resolution"/>
                </Grid>
                <Grid Margin="0,0,0,22">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Frame rate"/><TextBlock Style="{StaticResource FieldHint}" Text="60 fps updates motion more often and uses more bandwidth than 30 fps."/></StackPanel>
                  <ComboBox x:Name="Rate" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Top" AutomationProperties.Name="Frame rate"/>
                </Grid>
                <Grid Margin="0,0,0,22">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Codec"/><TextBlock Style="{StaticResource FieldHint}" Text="H.265 usually uses less bandwidth than H.264 at similar quality. H.265 HDR sends 10-bit video; turn Windows HDR on first with Win+Alt+B."/></StackPanel>
                  <ComboBox x:Name="Codec" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Top" AutomationProperties.Name="Codec"/>
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Bitrate"/><TextBlock Style="{StaticResource FieldHint}" Text="0 uses the standard bitrate for the selected resolution. Higher values can hold more detail and need more bandwidth."/></StackPanel>
                  <StackPanel Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                    <Grid>
                      <TextBox x:Name="Bitrate" Padding="12,0,56,0" AutomationProperties.Name="Bitrate in kilobits per second"/>
                      <TextBlock Style="{StaticResource Unit}" Text="kbps" HorizontalAlignment="Right" Margin="0,0,13,0"/>
                    </Grid>
                    <Slider x:Name="BitrateSlider" Margin="0,6,0,0" Minimum="0" Maximum="60000" TickFrequency="500" IsSnapToTickEnabled="True" Value="{Binding Text, ElementName=Bitrate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled, ElementName=Bitrate}" AutomationProperties.Name="Bitrate slider"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
            <Border BorderBrush="{StaticResource Signal}" BorderThickness="2,0,0,0" Padding="16,2,0,2" Margin="2,18,0,4">
              <TextBlock Style="{StaticResource Margin}" Text="If video stutters, lower the bitrate before the resolution. A wired PC or 5/6 GHz Wi-Fi close to the router usually gives a steadier connection."/>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- 03 PICTURE -->
      <TabItem x:Name="PictureTab" Header="Picture" Tag="03">
        <ScrollViewer Style="{StaticResource PageScroll}">
          <StackPanel Style="{StaticResource Page}">
            <Grid Margin="0,4,0,20">
              <StackPanel>
                <TextBlock Style="{StaticResource Eyebrow}" Text="PICTURE"/>
                <TextBlock Style="{StaticResource PageTitle}" Text="Decode and display" Margin="0,2,0,0"/>
              </StackPanel>
            </Grid>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource Eyebrow}" Text="DISPLAY PIPELINE"/>
                <TextBlock Style="{StaticResource CardTitle}" Text="Decode and draw" Margin="0,2,0,4"/>
                <TextBlock Style="{StaticResource FieldHint}" Margin="0,0,0,16" Text="These choices control how decoded video reaches the window."/>
                <Grid Margin="0,0,0,22">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Decoder"/><TextBlock Style="{StaticResource FieldHint}" Text="Automatic lets the player choose. Software decoding can use more CPU."/></StackPanel>
                  <ComboBox x:Name="Decoder" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Top" AutomationProperties.Name="Decoder"/>
                </Grid>
                <Grid Margin="0,0,0,22">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Renderer"/><TextBlock Style="{StaticResource FieldHint}" Text="Vulkan is the default renderer. OpenGL cannot display H.265 HDR."/></StackPanel>
                  <ComboBox x:Name="Renderer" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Top" AutomationProperties.Name="Renderer"/>
                </Grid>
                <Grid Margin="0,0,0,22">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Scaling"/><TextBlock Style="{StaticResource FieldHint}" Text="Used when the video size differs from the window. High quality keeps debanding and dithering. EWA Lanczos sharp is the tuned quality choice. Direct disables most picture cleanup."/></StackPanel>
                  <ComboBox x:Name="Scaling" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Top" AutomationProperties.Name="Scaling"/>
                </Grid>
                <Grid Margin="0,0,0,22">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Frame mixer"/><TextBlock Style="{StaticResource FieldHint}" Text="Direct presents frames as they arrive. Other modes can blend frames for smoother motion and may soften detail."/></StackPanel>
                  <ComboBox x:Name="Mixer" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Top" AutomationProperties.Name="Frame mixer"/>
                </Grid>
                <Grid Margin="0,0,0,22">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Window"/><TextBlock Style="{StaticResource FieldHint}" Text="Choose the window size or fullscreen behavior when the player opens."/></StackPanel>
                  <ComboBox x:Name="WindowMode" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Top" AutomationProperties.Name="Window mode"/>
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Sync"/><TextBlock Style="{StaticResource FieldHint}" Text="Can reduce tearing and may wait for the display refresh before showing a frame."/></StackPanel>
                  <CheckBox x:Name="Vsync" Grid.Column="1" Content="Vertical sync" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,4,0,0"/>
                </Grid>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
              <StackPanel>
                <StackPanel Margin="0,0,0,16">
                  <TextBlock Style="{StaticResource Eyebrow}" Text="COLOR GRADE"/>
                  <TextBlock Style="{StaticResource CardTitle}" Text="Optional color adjustment" Margin="0,2,0,4"/>
                  <TextBlock Style="{StaticResource FieldHint}" Text="Applied by the player on the GPU. Neutral values do nothing." Margin="0"/>
                </StackPanel>
                <Grid Margin="0,0,0,22">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Saturation"/><TextBlock Style="{StaticResource FieldHint}" Text="100 is unchanged."/></StackPanel>
                  <StackPanel Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                    <Grid>
                      <TextBox x:Name="ColorSat" Padding="12,0,40,0" AutomationProperties.Name="Color saturation percent"/>
                      <TextBlock Style="{StaticResource Unit}" Text="%" HorizontalAlignment="Right" Margin="0,0,15,0"/>
                    </Grid>
                    <Slider x:Name="ColorSatSlider" Margin="0,6,0,0" Minimum="0" Maximum="200" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding Text, ElementName=ColorSat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled, ElementName=ColorSat}" AutomationProperties.Name="Saturation slider"/>
                  </StackPanel>
                </Grid>
                <Grid Margin="0,0,0,22">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Vibrance"/><TextBlock Style="{StaticResource FieldHint}" Text="Lifts muted colors, leaves skin tones alone."/></StackPanel>
                  <StackPanel Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                    <Grid>
                      <TextBox x:Name="ColorVib" Padding="12,0,40,0" AutomationProperties.Name="Color vibrance"/>
                      <TextBlock Style="{StaticResource Unit}" Text="%" HorizontalAlignment="Right" Margin="0,0,15,0"/>
                    </Grid>
                    <Slider x:Name="ColorVibSlider" Margin="0,6,0,0" Minimum="-100" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding Text, ElementName=ColorVib, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled, ElementName=ColorVib}" AutomationProperties.Name="Vibrance slider"/>
                  </StackPanel>
                </Grid>
                <Grid Margin="0,0,0,22">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Contrast"/><TextBlock Style="{StaticResource FieldHint}" Text="Separates darks and lights around the picture's average."/></StackPanel>
                  <StackPanel Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                    <Grid>
                      <TextBox x:Name="ColorCon" Padding="12,0,40,0" AutomationProperties.Name="Color contrast percent"/>
                      <TextBlock Style="{StaticResource Unit}" Text="%" HorizontalAlignment="Right" Margin="0,0,15,0"/>
                    </Grid>
                    <Slider x:Name="ColorConSlider" Margin="0,6,0,0" Minimum="50" Maximum="200" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding Text, ElementName=ColorCon, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled, ElementName=ColorCon}" AutomationProperties.Name="Contrast slider"/>
                  </StackPanel>
                </Grid>
                <Grid Margin="0,0,0,22">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Brightness"/><TextBlock Style="{StaticResource FieldHint}" Text="Lifts or lowers the whole picture."/></StackPanel>
                  <StackPanel Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                    <Grid>
                      <TextBox x:Name="ColorBri" Padding="12,0,40,0" AutomationProperties.Name="Color brightness percent"/>
                      <TextBlock Style="{StaticResource Unit}" Text="%" HorizontalAlignment="Right" Margin="0,0,15,0"/>
                    </Grid>
                    <Slider x:Name="ColorBriSlider" Margin="0,6,0,0" Minimum="-50" Maximum="50" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Text, ElementName=ColorBri, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled, ElementName=ColorBri}" AutomationProperties.Name="Brightness slider"/>
                  </StackPanel>
                </Grid>
                <Grid Margin="0,0,0,22">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Temperature"/><TextBlock Style="{StaticResource FieldHint}" Text="Warm toward orange, cool toward blue."/></StackPanel>
                  <StackPanel Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                    <Grid>
                      <TextBox x:Name="ColorTemp" Padding="12,0" AutomationProperties.Name="Color temperature"/>
                    </Grid>
                    <Slider x:Name="ColorTempSlider" Margin="0,6,0,0" Minimum="-100" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding Text, ElementName=ColorTemp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled, ElementName=ColorTemp}" AutomationProperties.Name="Temperature slider"/>
                  </StackPanel>
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Tint"/><TextBlock Style="{StaticResource FieldHint}" Text="Shift toward magenta or green."/></StackPanel>
                  <StackPanel Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                    <Grid>
                      <TextBox x:Name="ColorTint" Padding="12,0" AutomationProperties.Name="Color tint"/>
                    </Grid>
                    <Slider x:Name="ColorTintSlider" Margin="0,6,0,0" Minimum="-100" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding Text, ElementName=ColorTint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled, ElementName=ColorTint}" AutomationProperties.Name="Tint slider"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- 04 SOUND -->
      <TabItem x:Name="SoundTab" Header="Sound" Tag="04">
        <ScrollViewer Style="{StaticResource PageScroll}">
          <StackPanel Style="{StaticResource Page}">
            <Grid Margin="0,4,0,20">
              <StackPanel>
                <TextBlock Style="{StaticResource Eyebrow}" Text="SOUND"/>
                <TextBlock Style="{StaticResource PageTitle}" Text="Volume and audio delay" Margin="0,2,0,0"/>
              </StackPanel>
            </Grid>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource Eyebrow}" Text="PLAYBACK"/>
                <TextBlock Style="{StaticResource CardTitle}" Text="Audio output" Margin="0,2,0,4"/>
                <TextBlock Style="{StaticResource FieldHint}" Margin="0,0,0,16" Text="Controls the player's own output volume."/>
                <Grid Margin="0,0,0,22">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Volume"/><TextBlock Style="{StaticResource FieldHint}" Text="0 is muted and 100 is full volume in the player."/></StackPanel>
                  <StackPanel Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                    <Grid>
                      <TextBox x:Name="Volume" Padding="12,0,40,0" AutomationProperties.Name="Volume percent"/>
                      <TextBlock Style="{StaticResource Unit}" Text="%" HorizontalAlignment="Right" Margin="0,0,15,0"/>
                    </Grid>
                    <Slider x:Name="VolumeSlider" Margin="0,6,0,0" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Text, ElementName=Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled, ElementName=Volume}" AutomationProperties.Name="Volume slider"/>
                  </StackPanel>
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Audio buffer"/><TextBlock Style="{StaticResource FieldHint}" Text="0 chooses automatically. Larger values tolerate network variation and increase audio delay."/></StackPanel>
                  <StackPanel Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                    <Grid>
                      <TextBox x:Name="AudioBuffer" Padding="12,0,44,0" AutomationProperties.Name="Audio buffer in milliseconds"/>
                      <TextBlock Style="{StaticResource Unit}" Text="ms" HorizontalAlignment="Right" Margin="0,0,13,0"/>
                    </Grid>
                    <Slider x:Name="BufferSlider" Margin="0,6,0,0" Minimum="0" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding Text, ElementName=AudioBuffer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled, ElementName=AudioBuffer}" AutomationProperties.Name="Audio buffer slider"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
            <Border BorderBrush="{StaticResource Signal}" BorderThickness="2,0,0,0" Padding="16,2,0,2" Margin="2,18,0,4">
              <TextBlock Style="{StaticResource Margin}" Text="A smaller buffer reduces the extra audio delay added here and can crackle when the network or PC is busy. Raise it if you hear dropouts."/>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- 05 CONTROLS -->
      <TabItem x:Name="ControlsTab" Header="Controls" Tag="05">
        <ScrollViewer Style="{StaticResource PageScroll}">
          <StackPanel Style="{StaticResource Page}">
            <Grid Margin="0,4,0,20">
              <StackPanel>
                <TextBlock Style="{StaticResource Eyebrow}" Text="CONTROLS"/>
                <TextBlock Style="{StaticResource PageTitle}" Text="Keyboard and mouse" Margin="0,2,0,0"/>
              </StackPanel>
            </Grid>

            <Border BorderBrush="{StaticResource Signal}" BorderThickness="2,0,0,0" Padding="14,2,0,2" Margin="0,0,0,16">
              <TextBlock Style="{StaticResource Margin}" Text="Keys can act as controller buttons while the player is open. Turn mouse aim off for normal controller play so a bumped mouse cannot fight the right stick. These settings are used the next time you connect."/>
            </Border>

            <!-- Input basics -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,0">
              <StackPanel>
                <TextBlock Style="{StaticResource Eyebrow}" Text="INPUT BASICS"/>
                <TextBlock Style="{StaticResource CardTitle}" Text="The main switches" Margin="0,2,0,4"/>
                <TextBlock Style="{StaticResource FieldHint}" Margin="0,0,0,16" Text="Start here. Most players only need the mouse aim switch and sensitivity."/>
                <Grid Margin="0,0,0,22">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Keyboard"/><TextBlock Style="{StaticResource FieldHint}" Text="Keys act as controller buttons while the player is open."/></StackPanel>
                  <CheckBox x:Name="KeyboardEnabled" Grid.Column="1" Content="Use keyboard as a controller" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,4,0,0" AutomationProperties.Name="Keyboard as controller"/>
                </Grid>
                <Grid Margin="0,0,0,22">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Mouse aim"/><TextBlock Style="{StaticResource FieldHint}" Text="Moving the mouse steers the right stick."/></StackPanel>
                  <CheckBox x:Name="MouseAim" Grid.Column="1" Content="Use mouse aim" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,4,0,0" AutomationProperties.Name="Mouse aim"/>
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Aim sensitivity"/><TextBlock Style="{StaticResource FieldHint}" Text="Higher values turn mouse movement into stick movement faster."/></StackPanel>
                  <StackPanel Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                    <TextBox x:Name="AimSensitivity" AutomationProperties.Name="Aim sensitivity"/>
                    <Slider x:Name="AimSensitivitySlider" Margin="0,6,0,0" Minimum="0.1" Maximum="10" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding Text, ElementName=AimSensitivity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled, ElementName=AimSensitivity}" AutomationProperties.Name="Sensitivity slider"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <!-- DualSense -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
              <StackPanel>
                <TextBlock Style="{StaticResource Eyebrow}" Text="DUALSENSE"/>
                <TextBlock Style="{StaticResource CardTitle}" Text="Controller feel" Margin="0,2,0,4"/>
                <TextBlock Style="{StaticResource FieldHint}" Margin="0,0,0,16" Text="For full HD haptics use USB-C, set the controller's Windows sound device to Quadraphonic and close Steam Input or DS4Windows while streaming."/>
                <Grid Margin="0,0,0,22">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="HD haptics strength"/><TextBlock Style="{StaticResource FieldHint}" Text="100% is the normal USB DualSense haptic strength."/></StackPanel>
                  <StackPanel Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                    <Grid>
                      <TextBox x:Name="HapticOverride" Padding="12,0,40,0" AutomationProperties.Name="HD haptics strength percent"/>
                      <TextBlock Style="{StaticResource Unit}" Text="%" HorizontalAlignment="Right" Margin="0,0,15,0"/>
                    </Grid>
                    <Slider x:Name="HapticOverrideSlider" Margin="0,6,0,0" Minimum="25" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Text, ElementName=HapticOverride, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled, ElementName=HapticOverride}" AutomationProperties.Name="HD haptics strength slider"/>
                  </StackPanel>
                </Grid>
                <Grid Margin="0,0,0,22">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Bluetooth rumble"/><TextBlock Style="{StaticResource FieldHint}" Text="Used when USB HD haptics are unavailable, usually over Bluetooth."/></StackPanel>
                  <ComboBox x:Name="RumbleIntensity" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Top" AutomationProperties.Name="Bluetooth rumble strength"/>
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Background controller"/><TextBlock Style="{StaticResource FieldHint}" Text="Keep the controller active when you click another window or your second monitor."/></StackPanel>
                  <CheckBox x:Name="PadBackground" Grid.Column="1" Content="Keep controller active" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,4,0,0" AutomationProperties.Name="Keep controller active in background"/>
                </Grid>
              </StackPanel>
            </Border>

            <!-- Walking -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
              <StackPanel>
                <TextBlock Style="{StaticResource Eyebrow}" Text="WALKING"/>
                <TextBlock Style="{StaticResource CardTitle}" Text="Slow down the left stick" Margin="0,2,0,4"/>
                <TextBlock Style="{StaticResource FieldHint}" Margin="0,0,0,16" Text="Hold the walk key with WASD when a game needs slower movement."/>
                <Grid Margin="0,0,0,22">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Walk key"/><TextBlock Style="{StaticResource FieldHint}" Text="Hold this key to walk instead of run."/></StackPanel>
                  <ComboBox x:Name="WalkKey" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Top" AutomationProperties.Name="Walk key"/>
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Walk speed"/><TextBlock Style="{StaticResource FieldHint}" Text="A lower percentage walks more slowly."/></StackPanel>
                  <StackPanel Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                    <Grid>
                      <TextBox x:Name="WalkScale" Padding="12,0,40,0" AutomationProperties.Name="Walk speed percent"/>
                      <TextBlock Style="{StaticResource Unit}" Text="%" HorizontalAlignment="Right" Margin="0,0,15,0"/>
                    </Grid>
                    <Slider x:Name="WalkScaleSlider" Margin="0,6,0,0" Minimum="20" Maximum="80" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Text, ElementName=WalkScale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled, ElementName=WalkScale}" AutomationProperties.Name="Walk speed slider"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <!-- Keyboard layout -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
              <StackPanel>
                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Style="{StaticResource Eyebrow}" Text="KEYBOARD LAYOUT"/>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Button bindings" Margin="0,2,0,4"/>
                    <TextBlock Style="{StaticResource FieldHint}" Margin="0" Text="Read-only preview of the key each PS5 button uses. Editing opens the advanced app settings window."/>
                  </StackPanel>
                  <Button x:Name="EditKeyMap" Grid.Column="1" Style="{StaticResource SignalOutline}" Content="Edit key bindings" VerticalAlignment="Top" Margin="16,0,0,0" AutomationProperties.Name="Edit key bindings"/>
                </Grid>
                <UniformGrid x:Name="KeyMapGrid" Columns="2" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>

            <!-- Advanced mouse aim tuning, hidden until asked for -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Style="{StaticResource Eyebrow}" Text="MOUSE AIM"/>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Advanced tuning" Margin="0,2,0,4"/>
                    <TextBlock Style="{StaticResource FieldHint}" Margin="0" Text="Most players can leave these values unchanged."/>
                  </StackPanel>
                  <Button x:Name="AimAdvancedToggle" Grid.Column="1" Content="Show tuning" VerticalAlignment="Top" Margin="16,0,0,0" MinWidth="148"/>
                </Grid>
                <StackPanel x:Name="AimAdvancedPanel" Visibility="Collapsed" Margin="0,22,0,0">
                  <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Vertical ratio"/><TextBlock Style="{StaticResource FieldHint}" Text="1 keeps vertical and horizontal speed the same. Higher values make vertical aim faster."/></StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                      <TextBox x:Name="AimYRatio" AutomationProperties.Name="Aim vertical ratio"/>
                      <Slider x:Name="AimYRatioSlider" Margin="0,6,0,0" Minimum="0.25" Maximum="4" TickFrequency="0.25" IsSnapToTickEnabled="True" Value="{Binding Text, ElementName=AimYRatio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled, ElementName=AimYRatio}" AutomationProperties.Name="Vertical ratio slider"/>
                    </StackPanel>
                  </Grid>
                  <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Deadzone"/><TextBlock Style="{StaticResource FieldHint}" Text="Adds a small starting stick output so fine movement registers in games with a deadzone."/></StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                      <Grid>
                        <TextBox x:Name="AimDeadzone" Padding="12,0,40,0" AutomationProperties.Name="Aim deadzone percent"/>
                        <TextBlock Style="{StaticResource Unit}" Text="%" HorizontalAlignment="Right" Margin="0,0,15,0"/>
                      </Grid>
                      <Slider x:Name="AimDeadzoneSlider" Margin="0,6,0,0" Minimum="0" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Text, ElementName=AimDeadzone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled, ElementName=AimDeadzone}" AutomationProperties.Name="Deadzone slider"/>
                    </StackPanel>
                  </Grid>
                  <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Curve"/><TextBlock Style="{StaticResource FieldHint}" Text="1 is linear. Higher values give finer slow movement while keeping fast movement available."/></StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                      <TextBox x:Name="AimCurve" AutomationProperties.Name="Aim curve"/>
                      <Slider x:Name="AimCurveSlider" Margin="0,6,0,0" Minimum="0.3" Maximum="3" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding Text, ElementName=AimCurve, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled, ElementName=AimCurve}" AutomationProperties.Name="Curve slider"/>
                    </StackPanel>
                  </Grid>
                  <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Smoothing window"/><TextBlock Style="{StaticResource FieldHint}" Text="Averages mouse input over this many milliseconds. Lower values react sooner and can feel less steady."/></StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                      <Grid>
                        <TextBox x:Name="AimWindow" Padding="12,0,44,0" AutomationProperties.Name="Aim smoothing window milliseconds"/>
                        <TextBlock Style="{StaticResource Unit}" Text="ms" HorizontalAlignment="Right" Margin="0,0,13,0"/>
                      </Grid>
                      <Slider x:Name="AimWindowSlider" Margin="0,6,0,0" Minimum="2" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Text, ElementName=AimWindow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled, ElementName=AimWindow}" AutomationProperties.Name="Smoothing window slider"/>
                    </StackPanel>
                  </Grid>
                  <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Stop easing"/><TextBlock Style="{StaticResource FieldHint}" Text="Eases stick output back to center when mouse movement stops."/></StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                      <Grid>
                        <TextBox x:Name="AimTau" Padding="12,0,44,0" AutomationProperties.Name="Aim stop easing milliseconds"/>
                        <TextBlock Style="{StaticResource Unit}" Text="ms" HorizontalAlignment="Right" Margin="0,0,13,0"/>
                      </Grid>
                      <Slider x:Name="AimTauSlider" Margin="0,6,0,0" Minimum="0" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Text, ElementName=AimTau, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled, ElementName=AimTau}" AutomationProperties.Name="Stop easing slider"/>
                    </StackPanel>
                  </Grid>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Release key"/><TextBlock Style="{StaticResource FieldHint}" Text="Press this key or Esc to end mouse capture."/></StackPanel>
                    <ComboBox x:Name="AimRelease" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Top" AutomationProperties.Name="Aim release key"/>
                  </Grid>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Local aim preview -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
              <StackPanel>
                <TextBlock Style="{StaticResource Eyebrow}" Text="AIM PREVIEW"/>
                <TextBlock Style="{StaticResource CardTitle}" Text="Try the feel on this PC" Margin="0,2,0,4"/>
                <TextBlock Style="{StaticResource FieldHint}" Margin="0,0,0,14" Text="The graph shows stick output for mouse speed using the current draft values. The jump at the left edge is the deadzone floor."/>
                <Border Background="{StaticResource Field}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,16"><Canvas x:Name="ResponseGraph" Height="150"/></Border>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Canvas x:Name="AimPad" Width="190" Height="190" Background="Transparent" Cursor="Cross"/>
                  <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Muted}" Text="LOCAL AIM TEST"/>
                    <TextBlock x:Name="AimSpeed" FontFamily="{StaticResource Mono}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Paper}" Margin="0,8,0,0"/>
                    <TextBlock x:Name="AimStick" FontFamily="{StaticResource Mono}" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                    <TextBlock Style="{StaticResource Margin}" FontSize="12" Margin="0,12,0,0" Text="Click the pad to capture the mouse. Esc or the release key ends it. Input stays on this PC."/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <Border BorderBrush="{StaticResource Signal}" BorderThickness="2,0,0,0" Padding="16,2,0,2" Margin="2,18,0,4">
              <TextBlock Style="{StaticResource Margin}" Text="Keyboard, walking and mouse settings are used the next time you connect. The aim pad is a local preview only and never sends input to the PS5."/>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

    </TabControl>

    <!-- Shared footer: draft state, the latest result and the draft actions -->
    <Border VerticalAlignment="Bottom" Height="72" Margin="204,0,0,0" Background="#050505" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
      <Grid Margin="32,0,28,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
          <StackPanel x:Name="DraftBadge" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,2">
            <Ellipse Width="7" Height="7" Fill="{StaticResource Signal}" VerticalAlignment="Center"/>
            <TextBlock x:Name="DraftCount" Margin="7,0,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Signal}" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock x:Name="Notice" Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" LineHeight="18" MaxHeight="36" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="Revert" Content="Reset to saved" Margin="0,0,12,0" MinWidth="136"/>
          <Button x:Name="Apply" Style="{StaticResource Accent}" Content="Save settings" MinWidth="148"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Rail footer: view switch and pad legend, outside the tab template so the controller can own it -->
    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="204" Background="{StaticResource Rail}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,1,0" Padding="20,16,20,18">
      <StackPanel>
        <TextBlock x:Name="PadHint" Visibility="Collapsed" Margin="0,0,0,14" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="17"
                   Text="Controller ready&#10;A select   B back&#10;LB RB switch page"/>
        <DockPanel>
          <TextBlock Text="VIEW" FontFamily="{StaticResource Mono}" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
