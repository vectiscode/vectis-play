<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vectis Play" Width="980" Height="680" MinWidth="820" MinHeight="580"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="#0F0E0D" Foreground="#F2ECE6" FontFamily="Segoe UI, Bahnschrift" FontSize="14"
        TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <!-- Palette: charcoal ink, warm paper text, one coral signal accent -->
    <SolidColorBrush x:Key="Ink" Color="#0F0E0D"/>
    <SolidColorBrush x:Key="Rail" Color="#131110"/>
    <SolidColorBrush x:Key="Panel" Color="#181513"/>
    <SolidColorBrush x:Key="Field" Color="#14110F"/>
    <SolidColorBrush x:Key="Line" Color="#2B2724"/>
    <SolidColorBrush x:Key="Line2" Color="#463F39"/>
    <SolidColorBrush x:Key="Paper" Color="#F2ECE6"/>
    <SolidColorBrush x:Key="Muted" Color="#A89F98"/>
    <SolidColorBrush x:Key="Signal" Color="#FF5B4B"/>
    <SolidColorBrush x:Key="SignalDeep" Color="#D1281F"/>
    <SolidColorBrush x:Key="SignalInk" Color="#160805"/>
    <SolidColorBrush x:Key="FocusRing" Color="#FFC9BF"/>
    <FontFamily x:Key="Display">Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="Mono">Consolas</FontFamily>

    <!-- Text roles -->
    <Style x:Key="Eyebrow" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource Signal}"/>
    </Style>
    <Style x:Key="PageTitle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Display}"/>
      <Setter Property="FontStretch" Value="SemiCondensed"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="32"/>
      <Setter Property="Foreground" Value="{StaticResource Paper}"/>
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Display}"/>
      <Setter Property="FontStretch" Value="SemiCondensed"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="Foreground" Value="{StaticResource Paper}"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Panel}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="22,18"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Paper}"/>
    </Style>
    <Style x:Key="FieldHint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,2,16,0"/>
    </Style>
    <Style x:Key="Unit" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>
    <Style x:Key="Margin" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="19"/>
    </Style>

    <!-- Buttons: ghost by default, Accent for the one primary action -->
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Paper}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Face" MinWidth="104" MinHeight="38" CornerRadius="2" Background="#1E1A17" BorderBrush="{StaticResource Line2}" BorderThickness="1" Padding="18,0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#2A2420"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Background" Value="#120F0D"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource FocusRing}"/>
                <Setter TargetName="Face" Property="BorderThickness" Value="2"/>
                <Setter TargetName="Face" Property="Padding" Value="17,0"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Face" Property="Opacity" Value="0.4"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Accent" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="{StaticResource SignalInk}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Face" MinWidth="104" MinHeight="38" CornerRadius="2" Background="{StaticResource Signal}" BorderBrush="{StaticResource Signal}" BorderThickness="1" Padding="18,0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#FF7466"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Background" Value="#E04A3B"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Paper}"/>
                <Setter TargetName="Face" Property="BorderThickness" Value="2"/>
                <Setter TargetName="Face" Property="Padding" Value="17,0"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                <Setter TargetName="Face" Property="Background" Value="{StaticResource Field}"/>
                <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Line}"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Accent outline: signal border and text on transparent, for secondary accent actions -->
    <Style x:Key="SignalOutline" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="{StaticResource Signal}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Face" MinWidth="104" MinHeight="38" CornerRadius="2" Background="Transparent" BorderBrush="{StaticResource Signal}" BorderThickness="1" Padding="18,0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#2A1210"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Background" Value="#1A0C0A"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource FocusRing}"/>
                <Setter TargetName="Face" Property="BorderThickness" Value="2"/>
                <Setter TargetName="Face" Property="Padding" Value="17,0"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- TextBox -->
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource Paper}"/>
      <Setter Property="CaretBrush" Value="{StaticResource Signal}"/>
      <Setter Property="SelectionBrush" Value="{StaticResource Signal}"/>
      <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="11,0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Frame" Background="{StaticResource Field}" BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="2">
              <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#6A6058"/></Trigger>
              <Trigger Property="Tag" Value="changed"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Signal}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource FocusRing}"/>
                <Setter TargetName="Frame" Property="BorderThickness" Value="2"/>
                <Setter TargetName="Frame" Property="Background" Value="#1B1613"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ComboBox -->
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Paper}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Row" Height="34" Padding="12,0" Background="Transparent" BorderThickness="3,0,0,0" BorderBrush="Transparent">
              <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="#2A2420"/></Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Signal}"/>
                <Setter TargetName="Row" Property="Background" Value="#241D1A"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource Paper}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="MaxDropDownHeight" Value="280"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <Border x:Name="Frame" Background="{StaticResource Field}" BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="2"/>
              <ToggleButton Focusable="False" ClickMode="Press" Background="Transparent" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                      <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0" Data="M0 0L5 5L10 0" Stroke="{StaticResource Muted}" StrokeThickness="1.6" StrokeLineJoin="Round"/>
                    </Grid>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter IsHitTestVisible="False" Margin="12,0,34,0" VerticalAlignment="Center" HorizontalAlignment="Left" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" TextElement.Foreground="{TemplateBinding Foreground}"/>
              <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade" IsOpen="{TemplateBinding IsDropDownOpen}">
                <Border MinWidth="{Binding ActualWidth, ElementName=Frame}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,2,10,12" Background="#1B1816" BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="2" SnapsToDevicePixels="True">
                  <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="4" Opacity="0.55" Color="#000000"/></Border.Effect>
                  <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#6A6058"/></Trigger>
              <Trigger Property="Tag" Value="changed"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Signal}"/></Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource FocusRing}"/>
                <Setter TargetName="Frame" Property="BorderThickness" Value="2"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- CheckBox -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Paper}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="Box" Width="22" Height="22" Background="{StaticResource Field}" BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="2" VerticalAlignment="Center">
                <Path x:Name="Tick" Visibility="Collapsed" Data="M4 11L9 16L18 5" Stroke="{StaticResource Signal}" StrokeThickness="2.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              </Border>
              <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="Tick" Property="Visibility" Value="Visible"/><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Signal}"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="#241D1A"/></Trigger>
              <Trigger Property="Tag" Value="changed"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Signal}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource FocusRing}"/>
                <Setter TargetName="Box" Property="BorderThickness" Value="2"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Slider: 4px track, signal fill up to the thumb, ring on keyboard focus -->
    <Style TargetType="Slider">
      <Setter Property="Height" Value="22"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid>
              <Border Height="4" VerticalAlignment="Center" Background="{StaticResource Line2}" CornerRadius="2"/>
              <Track x:Name="PART_Track" IsDirectionReversed="False">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" IsTabStop="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" VerticalAlignment="Center" Background="{StaticResource Signal}" CornerRadius="2"/>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" IsTabStop="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border Padding="4">
                          <Border x:Name="Knob" Width="14" Height="14" CornerRadius="7" Background="{StaticResource Paper}" BorderBrush="{StaticResource Signal}" BorderThickness="1.5"/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=Slider}}" Value="True">
                            <Setter TargetName="Knob" Property="BorderBrush" Value="{StaticResource FocusRing}"/>
                            <Setter TargetName="Knob" Property="BorderThickness" Value="2"/>
                          </DataTrigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Slim vertical scrollbar -->
    <Style x:Key="PageButton" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource PageButton}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource PageButton}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Margin="2,0" Background="#4A423C" CornerRadius="3"/></ControlTemplate></Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Left rail: TabControl restyled as a sidebar, brand mark inside the template -->
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontFamily" Value="{StaticResource Display}"/>
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="Row" Height="48" Background="Transparent" BorderThickness="0,0,0,0" BorderBrush="Transparent">
              <Grid>
                <Border x:Name="Bar" Width="3" HorizontalAlignment="Left" Background="{StaticResource Signal}" Visibility="Hidden"/>
                <Border x:Name="Ring" BorderThickness="2" BorderBrush="Transparent" Margin="6,2,4,2" CornerRadius="2"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="26,0,0,0">
                  <TextBlock Text="{TemplateBinding Tag}" FontFamily="Consolas" FontSize="12" FontWeight="Normal" Foreground="{StaticResource Signal}" Width="30" VerticalAlignment="Center"/>
                  <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
                </StackPanel>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#1A1715"/></Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Row" Property="Background" Value="#211C19"/>
                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource FocusRing}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{StaticResource Paper}"/></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Paper}"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="TabControl">
      <Setter Property="Background" Value="{StaticResource Ink}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="224"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Background="{StaticResource Rail}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="False">
                  <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="26,30,0,34">
                    <Viewbox Width="30" Height="30" Stretch="Uniform">
                      <Canvas Width="760" Height="760">
                        <Canvas.RenderTransform><TranslateTransform X="-118" Y="-192"/></Canvas.RenderTransform>
                        <Path Fill="#F2ECE6" Data="M143 210H335C398 210 438 248 458 322C492 450 532 680 566 830L518 935Z"/>
                        <Path Fill="#D1281F" Data="M680 210H853L566 830C546 750 544 610 562 470C580 330 606 210 680 210Z"/>
                        <Path Fill="#99251E" Data="M853 210C730 340 600 500 558 720L566 830Z"/>
                      </Canvas>
                    </Viewbox>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="Vectis Play" FontFamily="{StaticResource Display}" FontStretch="SemiCondensed" FontWeight="SemiBold" FontSize="21" Foreground="{StaticResource Paper}"/>
                      <TextBlock Text="PS5 REMOTE PLAY" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                  </StackPanel>
                  <StackPanel IsItemsHost="True" DockPanel.Dock="Top" KeyboardNavigation.TabNavigation="Once"/>
                  <StackPanel DockPanel.Dock="Bottom" Margin="26,0,0,26" HorizontalAlignment="Left">
                    <TextBlock Text="chiaki-ng 1.10.1" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Muted}"/>
                    <TextBlock Text="AGPL-3.0" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Muted}"/>
                  </StackPanel>
                </DockPanel>
              </Border>
              <ContentPresenter Grid.Column="1" ContentSource="SelectedContent" Margin="0,0,0,76"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <TabControl x:Name="Pages" TabStripPlacement="Left">

      <!-- 01 SESSION -->
      <TabItem x:Name="SessionTab" Header="Session" Tag="01">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <StackPanel Margin="40,30,40,18" MaxWidth="860" HorizontalAlignment="Left">

            <!-- Home hero: identity, state and the one dominant action -->
            <Border Style="{StaticResource Card}" Padding="26,18,26,14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="230"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                  <TextBlock Style="{StaticResource Eyebrow}" Text="HOME"/>
                  <TextBlock x:Name="SessionTitle" Style="{StaticResource PageTitle}" Text="Pair your PS5" Margin="0,2,0,8" TextWrapping="Wrap"/>
                  <TextBlock x:Name="SessionDetail" Style="{StaticResource Margin}" Text="Keep the console awake on the same network as this PC." MaxWidth="510"/>
                  <ComboBox x:Name="ConsoleList" Visibility="Collapsed" Margin="0,14,0,0" MaxWidth="420" HorizontalAlignment="Left" Width="420" AutomationProperties.Name="Console"/>
                  <WrapPanel Margin="0,16,0,0">
                    <Button x:Name="Manage" Content="Pair or manage" Visibility="Collapsed" Margin="0,0,10,4" FontSize="13"/>
                    <Button x:Name="NativeSettings" Content="Controller settings" Margin="0,0,10,4" FontSize="13"/>
                  </WrapPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <Border Background="{StaticResource Field}" BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="2" Padding="10,5" HorizontalAlignment="Left" Margin="0,0,0,14">
                    <TextBlock x:Name="SessionState" Text="READY" FontFamily="{StaticResource Mono}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Signal}"/>
                  </Border>
                  <Button x:Name="Primary" Style="{StaticResource Accent}" Content="Pair PS5" Width="220" Height="56" FontSize="18" MinWidth="0"/>
                </StackPanel>
              </Grid>
            </Border>

            <!-- Simple mode: the few choices most players need -->
            <Border x:Name="QuickSetupCard" Style="{StaticResource Card}" Margin="0,16,0,0">
              <StackPanel>
                <Grid Margin="0,0,0,18">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Eyebrow}" Text="QUICK SETUP"/>
                    <TextBlock Style="{StaticResource CardTitle}" Text="The essentials" Margin="0,2,0,0"/>
                  </StackPanel>
                  <TextBlock Style="{StaticResource FieldHint}" Margin="0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="Only the choices most players need."/>
                </Grid>
                <UniformGrid Columns="2">
                  <StackPanel Margin="0,0,14,12">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Performance"/>
                    <ComboBox x:Name="PerformancePreset" Margin="0,8,0,0" AutomationProperties.Name="Performance preset"/>
                    <TextBlock Style="{StaticResource FieldHint}" Margin="0,6,0,0" Text="Controls picture processing."/>
                  </StackPanel>
                  <StackPanel Margin="0,0,0,12">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Picture quality"/>
                    <ComboBox x:Name="SimpleQuality" Margin="0,8,0,0" AutomationProperties.Name="Picture quality preset"/>
                    <TextBlock Style="{StaticResource FieldHint}" Margin="0,6,0,0" Text="Sharper video needs more bandwidth."/>
                  </StackPanel>
                  <StackPanel Margin="0,0,14,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Mouse aim"/>
                    <CheckBox x:Name="SimpleMouseAim" Content="Use the mouse to aim" Margin="0,9,0,0" AutomationProperties.Name="Use the mouse to aim"/>
                    <Grid Margin="0,10,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="74"/><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <TextBlock Text="Sensitivity" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                      <TextBox x:Name="SimpleAimSensitivity" Grid.Column="1" AutomationProperties.Name="Simple aim sensitivity"/>
                      <Slider x:Name="SimpleAimSensitivitySlider" Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Minimum="0.1" Maximum="10" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding Text, ElementName=SimpleAimSensitivity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled, ElementName=SimpleAimSensitivity}" AutomationProperties.Name="Simple sensitivity slider"/>
                    </Grid>
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Audio volume"/>
                    <Grid Margin="0,8,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <Grid>
                        <TextBox x:Name="SimpleVolume" Padding="11,0,28,0" AutomationProperties.Name="Simple audio volume percent"/>
                        <TextBlock Style="{StaticResource Unit}" Text="%" HorizontalAlignment="Right" Margin="0,0,11,0"/>
                      </Grid>
                      <Slider x:Name="SimpleVolumeSlider" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Text, ElementName=SimpleVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled, ElementName=SimpleVolume}" AutomationProperties.Name="Simple volume slider"/>
                    </Grid>
                    <TextBlock Style="{StaticResource FieldHint}" Margin="0,6,0,0" Text="0 is muted. 100 is full volume."/>
                  </StackPanel>
                </UniformGrid>
                <Border BorderBrush="{StaticResource Signal}" BorderThickness="2,0,0,0" Padding="14,2,0,2" Margin="0,10,0,0">
                  <TextBlock Style="{StaticResource Margin}" Text="Low latency writes 60 fps, fast scaling, direct frame mapping, H.265 and the standard bitrate for the resolution. Balanced writes automatic bitrate and standard high-quality scaling. Nothing is used until you save it."/>
                </Border>
              </StackPanel>
            </Border>

            <!-- Advanced mode: read-only summary of the saved detailed profile -->
            <Border x:Name="AdvancedSummary" Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="Collapsed">
              <StackPanel>
                <TextBlock Style="{StaticResource Eyebrow}" Text="SAVED FOR THE NEXT SESSION"/>
                <TextBlock Style="{StaticResource CardTitle}" Text="Current stream profile" Margin="0,2,0,4"/>
                <TextBlock Style="{StaticResource FieldHint}" Margin="0,0,0,14" Text="Read-only summary. Edit these values in the advanced tabs."/>
                <UniformGrid Columns="3">
                  <Border Background="{StaticResource Field}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="12,9" Margin="0,0,10,10">
                    <StackPanel>
                      <TextBlock Text="RESOLUTION" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Muted}"/>
                      <TextBlock x:Name="SumResolution" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Paper}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </StackPanel>
                  </Border>
                  <Border Background="{StaticResource Field}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="12,9" Margin="0,0,10,10">
                    <StackPanel>
                      <TextBlock Text="FRAME RATE" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Muted}"/>
                      <TextBlock x:Name="SumRate" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Paper}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </StackPanel>
                  </Border>
                  <Border Background="{StaticResource Field}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="12,9" Margin="0,0,10,10">
                    <StackPanel>
                      <TextBlock Text="BITRATE" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Muted}"/>
                      <TextBlock x:Name="SumBitrate" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Paper}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </StackPanel>
                  </Border>
                  <Border Background="{StaticResource Field}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="12,9" Margin="0,0,10,10">
                    <StackPanel>
                      <TextBlock Text="DECODER" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Muted}"/>
                      <TextBlock x:Name="SumDecoder" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Paper}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </StackPanel>
                  </Border>
                  <Border Background="{StaticResource Field}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="12,9" Margin="0,0,10,10">
                    <StackPanel>
                      <TextBlock Text="SCALING" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Muted}"/>
                      <TextBlock x:Name="SumScaling" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Paper}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </StackPanel>
                  </Border>
                  <Border Background="{StaticResource Field}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="12,9" Margin="0,0,10,10">
                    <StackPanel>
                      <TextBlock Text="AUDIO BUFFER" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Muted}"/>
                      <TextBlock x:Name="SumBuffer" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Paper}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </StackPanel>
                  </Border>
                </UniformGrid>
              </StackPanel>
            </Border>

            <!-- Network check: useful in both simple and advanced modes -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
              <StackPanel>
                <Grid Margin="0,0,0,8">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Eyebrow}" Text="NETWORK CHECK"/>
                    <TextBlock Style="{StaticResource CardTitle}" Text="How steady is the first hop?" Margin="0,2,0,0"/>
                  </StackPanel>
                  <Button x:Name="CheckLink" Style="{StaticResource SignalOutline}" Content="Check my network" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="150"/>
                </Grid>
                <TextBlock Style="{StaticResource FieldHint}" Margin="0,0,0,14" Text="Tests the hop between this PC and your router for 10 seconds. The PS5 is not contacted. Adapter speed is the negotiated link rate, not an internet speed test. If a bitrate is suggested, using it only updates the draft; choose Save settings to keep it."/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="260"/>
                    <ColumnDefinition Width="242"/>
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Background="{StaticResource Field}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Height="150" ClipToBounds="True">
                    <Canvas x:Name="LinkTrace"/>
                  </Border>
                  <UniformGrid Grid.Column="1" Columns="2" Rows="3" Margin="16,0,0,0">
                    <StackPanel Margin="0,0,12,10">
                      <TextBlock Text="CONNECTION" FontFamily="{StaticResource Mono}" FontSize="10" Foreground="{StaticResource Muted}"/>
                      <TextBlock x:Name="LinkKind" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Paper}" Margin="0,3,0,0" TextWrapping="Wrap" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                      <TextBlock Text="WI-FI SIGNAL" FontFamily="{StaticResource Mono}" FontSize="10" Foreground="{StaticResource Muted}"/>
                      <TextBlock x:Name="LinkSignal" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Paper}" Margin="0,3,0,0" TextWrapping="Wrap" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,10">
                      <TextBlock Text="ADAPTER SPEED" FontFamily="{StaticResource Mono}" FontSize="10" Foreground="{StaticResource Muted}"/>
                      <TextBlock x:Name="LinkReceive" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Paper}" Margin="0,3,0,0" TextWrapping="Wrap" ToolTip="The negotiated receive rate of the network adapter."/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                      <TextBlock Text="TYPICAL DELAY" FontFamily="{StaticResource Mono}" FontSize="10" Foreground="{StaticResource Muted}"/>
                      <TextBlock x:Name="LinkMedian" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Paper}" Margin="0,3,0,0" TextWrapping="Wrap" ToolTip="Half of the router replies were faster than this and half were slower."/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,10">
                      <TextBlock Text="HIGH DELAY" FontFamily="{StaticResource Mono}" FontSize="10" Foreground="{StaticResource Muted}"/>
                      <TextBlock x:Name="LinkP95" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Paper}" Margin="0,3,0,0" TextWrapping="Wrap" ToolTip="95 percent of router replies were at or below this delay."/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                      <TextBlock Text="SPIKES + LOSS" FontFamily="{StaticResource Mono}" FontSize="10" Foreground="{StaticResource Muted}"/>
                      <TextBlock x:Name="LinkSpikes" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Paper}" Margin="0,3,0,0" TextWrapping="Wrap" ToolTip="How many delay spikes were seen and how many replies were missing."/>
                    </StackPanel>
                  </UniformGrid>
                </Grid>
                <WrapPanel Margin="0,12,0,0">
                  <Button x:Name="UseLinkBitrate" Style="{StaticResource SignalOutline}" Content="Use suggested bitrate" Visibility="Collapsed" MinWidth="150"/>
                </WrapPanel>
                <TextBlock x:Name="LinkNotes" Style="{StaticResource FieldHint}" Margin="0,10,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- 02 STREAM -->
      <TabItem x:Name="StreamTab" Header="Stream" Tag="02">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <StackPanel Margin="40,32,34,20" MaxWidth="680" HorizontalAlignment="Left">
            <Grid Margin="0,0,0,26">
              <StackPanel>
                <TextBlock Style="{StaticResource Eyebrow}" Text="STREAM"/>
                <TextBlock Style="{StaticResource PageTitle}" Text="Picture size and bandwidth" Margin="0,2,0,0"/>
              </StackPanel>
              <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" Stroke="#FF5B4B" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M0 20H14L20 4L30 36L38 12L44 20H80" Width="80" Height="40" Stretch="None"/>
            </Grid>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource Eyebrow}" Text="STREAM SETTINGS"/>
                <TextBlock Style="{StaticResource CardTitle}" Text="Console video" Margin="0,2,0,4"/>
                <TextBlock Style="{StaticResource FieldHint}" Margin="0,0,0,16" Text="These choices decide how much picture data the PS5 sends."/>
                <Grid Margin="0,0,0,18">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Resolution"/><TextBlock Style="{StaticResource FieldHint}" Text="Higher resolutions look sharper and need more network bandwidth."/></StackPanel>
                  <ComboBox x:Name="Resolution" Grid.Column="1" Width="280" HorizontalAlignment="Left" VerticalAlignment="Top" AutomationProperties.Name="Resolution"/>
                </Grid>
                <Grid Margin="0,0,0,18">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Frame rate"/><TextBlock Style="{StaticResource FieldHint}" Text="60 fps updates motion more often and uses more bandwidth than 30 fps."/></StackPanel>
                  <ComboBox x:Name="Rate" Grid.Column="1" Width="280" HorizontalAlignment="Left" VerticalAlignment="Top" AutomationProperties.Name="Frame rate"/>
                </Grid>
                <Grid Margin="0,0,0,18">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Codec"/><TextBlock Style="{StaticResource FieldHint}" Text="H.265 usually uses less bandwidth than H.264 at similar quality."/></StackPanel>
                  <ComboBox x:Name="Codec" Grid.Column="1" Width="280" HorizontalAlignment="Left" VerticalAlignment="Top" AutomationProperties.Name="Codec"/>
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Bitrate"/><TextBlock Style="{StaticResource FieldHint}" Text="0 uses the standard bitrate for the selected resolution. Higher values can hold more detail and need more bandwidth."/></StackPanel>
                  <StackPanel Grid.Column="1" Width="280" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid>
                      <TextBox x:Name="Bitrate" Padding="11,0,56,0" AutomationProperties.Name="Bitrate in kilobits per second"/>
                      <TextBlock Style="{StaticResource Unit}" Text="kbps" HorizontalAlignment="Right" Margin="0,0,13,0"/>
                    </Grid>
                    <Slider x:Name="BitrateSlider" Margin="0,10,0,0" Minimum="0" Maximum="60000" TickFrequency="500" IsSnapToTickEnabled="True" Value="{Binding Text, ElementName=Bitrate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled, ElementName=Bitrate}" AutomationProperties.Name="Bitrate slider"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
            <Border BorderBrush="{StaticResource Signal}" BorderThickness="2,0,0,0" Padding="14,2,0,2" Margin="0,16,0,0">
              <TextBlock Style="{StaticResource Margin}" Text="If video stutters, lower the bitrate before the resolution. A wired PC or 5/6 GHz Wi-Fi close to the router usually gives a steadier connection."/>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- 03 PICTURE -->
      <TabItem x:Name="PictureTab" Header="Picture" Tag="03">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <StackPanel Margin="40,32,34,20" MaxWidth="680" HorizontalAlignment="Left">
            <Grid Margin="0,0,0,26">
              <StackPanel>
                <TextBlock Style="{StaticResource Eyebrow}" Text="PICTURE"/>
                <TextBlock Style="{StaticResource PageTitle}" Text="Decode and display" Margin="0,2,0,0"/>
              </StackPanel>
              <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" Stroke="#FF5B4B" StrokeThickness="2" StrokeLineJoin="Round" Data="M0 10V0H10M60 0H70V10M70 30V40H60M10 40H0V30M26 20H44" Width="70" Height="40" Stretch="None"/>
            </Grid>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource Eyebrow}" Text="DISPLAY PIPELINE"/>
                <TextBlock Style="{StaticResource CardTitle}" Text="Decode and draw" Margin="0,2,0,4"/>
                <TextBlock Style="{StaticResource FieldHint}" Margin="0,0,0,16" Text="These choices control how decoded video reaches the window."/>
                <Grid Margin="0,0,0,18">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Decoder"/><TextBlock Style="{StaticResource FieldHint}" Text="Automatic lets the player choose. Software decoding can use more CPU."/></StackPanel>
                  <ComboBox x:Name="Decoder" Grid.Column="1" Width="280" HorizontalAlignment="Left" VerticalAlignment="Top" AutomationProperties.Name="Decoder"/>
                </Grid>
                <Grid Margin="0,0,0,18">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Renderer"/><TextBlock Style="{StaticResource FieldHint}" Text="Vulkan is the default renderer. OpenGL cannot display H.265 HDR."/></StackPanel>
                  <ComboBox x:Name="Renderer" Grid.Column="1" Width="280" HorizontalAlignment="Left" VerticalAlignment="Top" AutomationProperties.Name="Renderer"/>
                </Grid>
                <Grid Margin="0,0,0,18">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Scaling"/><TextBlock Style="{StaticResource FieldHint}" Text="Used when the video size differs from the window. Direct does the least work. High quality is the player's standard scaling. Default is a lighter scaling preset."/></StackPanel>
                  <ComboBox x:Name="Scaling" Grid.Column="1" Width="280" HorizontalAlignment="Left" VerticalAlignment="Top" AutomationProperties.Name="Scaling"/>
                </Grid>
                <Grid Margin="0,0,0,18">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Frame mixer"/><TextBlock Style="{StaticResource FieldHint}" Text="Direct presents frames as they arrive. Other modes can blend frames for smoother motion and may soften detail."/></StackPanel>
                  <ComboBox x:Name="Mixer" Grid.Column="1" Width="280" HorizontalAlignment="Left" VerticalAlignment="Top" AutomationProperties.Name="Frame mixer"/>
                </Grid>
                <Grid Margin="0,0,0,18">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Window"/><TextBlock Style="{StaticResource FieldHint}" Text="Choose the window size or fullscreen behavior when the player opens."/></StackPanel>
                  <ComboBox x:Name="WindowMode" Grid.Column="1" Width="280" HorizontalAlignment="Left" VerticalAlignment="Top" AutomationProperties.Name="Window mode"/>
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Sync"/><TextBlock Style="{StaticResource FieldHint}" Text="Can reduce tearing and may wait for the display refresh before showing a frame."/></StackPanel>
                  <CheckBox x:Name="Vsync" Grid.Column="1" Content="Vertical sync" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,7,0,0"/>
                </Grid>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
              <StackPanel>
                <StackPanel Margin="0,0,0,16">
                  <TextBlock Style="{StaticResource Eyebrow}" Text="COLOR GRADE"/>
                  <TextBlock Style="{StaticResource CardTitle}" Text="Optional color adjustment" Margin="0,2,0,4"/>
                  <TextBlock Style="{StaticResource FieldHint}" Text="Applied by the player on the GPU. Neutral values do nothing." Margin="0"/>
                </StackPanel>
                <Grid Margin="0,0,0,18">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Saturation"/><TextBlock Style="{StaticResource FieldHint}" Text="100 is unchanged."/></StackPanel>
                  <StackPanel Grid.Column="1" Width="220" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid>
                      <TextBox x:Name="ColorSat" Padding="11,0,40,0" AutomationProperties.Name="Color saturation percent"/>
                      <TextBlock Style="{StaticResource Unit}" Text="%" HorizontalAlignment="Right" Margin="0,0,15,0"/>
                    </Grid>
                    <Slider x:Name="ColorSatSlider" Margin="0,10,0,0" Minimum="0" Maximum="200" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding Text, ElementName=ColorSat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled, ElementName=ColorSat}" AutomationProperties.Name="Saturation slider"/>
                  </StackPanel>
                </Grid>
                <Grid Margin="0,0,0,18">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Vibrance"/><TextBlock Style="{StaticResource FieldHint}" Text="Lifts muted colors, leaves skin tones alone."/></StackPanel>
                  <StackPanel Grid.Column="1" Width="220" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid>
                      <TextBox x:Name="ColorVib" Padding="11,0,40,0" AutomationProperties.Name="Color vibrance"/>
                      <TextBlock Style="{StaticResource Unit}" Text="%" HorizontalAlignment="Right" Margin="0,0,15,0"/>
                    </Grid>
                    <Slider x:Name="ColorVibSlider" Margin="0,10,0,0" Minimum="-100" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding Text, ElementName=ColorVib, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled, ElementName=ColorVib}" AutomationProperties.Name="Vibrance slider"/>
                  </StackPanel>
                </Grid>
                <Grid Margin="0,0,0,18">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Contrast"/><TextBlock Style="{StaticResource FieldHint}" Text="Separates darks and lights around the picture's average."/></StackPanel>
                  <StackPanel Grid.Column="1" Width="220" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid>
                      <TextBox x:Name="ColorCon" Padding="11,0,40,0" AutomationProperties.Name="Color contrast percent"/>
                      <TextBlock Style="{StaticResource Unit}" Text="%" HorizontalAlignment="Right" Margin="0,0,15,0"/>
                    </Grid>
                    <Slider x:Name="ColorConSlider" Margin="0,10,0,0" Minimum="50" Maximum="200" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding Text, ElementName=ColorCon, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled, ElementName=ColorCon}" AutomationProperties.Name="Contrast slider"/>
                  </StackPanel>
                </Grid>
                <Grid Margin="0,0,0,18">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Brightness"/><TextBlock Style="{StaticResource FieldHint}" Text="Lifts or lowers the whole picture."/></StackPanel>
                  <StackPanel Grid.Column="1" Width="220" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid>
                      <TextBox x:Name="ColorBri" Padding="11,0,40,0" AutomationProperties.Name="Color brightness percent"/>
                      <TextBlock Style="{StaticResource Unit}" Text="%" HorizontalAlignment="Right" Margin="0,0,15,0"/>
                    </Grid>
                    <Slider x:Name="ColorBriSlider" Margin="0,10,0,0" Minimum="-50" Maximum="50" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Text, ElementName=ColorBri, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled, ElementName=ColorBri}" AutomationProperties.Name="Brightness slider"/>
                  </StackPanel>
                </Grid>
                <Grid Margin="0,0,0,18">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Temperature"/><TextBlock Style="{StaticResource FieldHint}" Text="Warm toward orange, cool toward blue."/></StackPanel>
                  <StackPanel Grid.Column="1" Width="220" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid>
                      <TextBox x:Name="ColorTemp" Padding="11,0,0,0" AutomationProperties.Name="Color temperature"/>
                    </Grid>
                    <Slider x:Name="ColorTempSlider" Margin="0,10,0,0" Minimum="-100" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding Text, ElementName=ColorTemp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled, ElementName=ColorTemp}" AutomationProperties.Name="Temperature slider"/>
                  </StackPanel>
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Tint"/><TextBlock Style="{StaticResource FieldHint}" Text="Shift toward magenta or green."/></StackPanel>
                  <StackPanel Grid.Column="1" Width="220" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid>
                      <TextBox x:Name="ColorTint" Padding="11,0,0,0" AutomationProperties.Name="Color tint"/>
                    </Grid>
                    <Slider x:Name="ColorTintSlider" Margin="0,10,0,0" Minimum="-100" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding Text, ElementName=ColorTint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled, ElementName=ColorTint}" AutomationProperties.Name="Tint slider"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- 04 SOUND -->
      <TabItem x:Name="SoundTab" Header="Sound" Tag="04">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <StackPanel Margin="40,32,34,20" MaxWidth="680" HorizontalAlignment="Left">
            <Grid Margin="0,0,0,26">
              <StackPanel>
                <TextBlock Style="{StaticResource Eyebrow}" Text="SOUND"/>
                <TextBlock Style="{StaticResource PageTitle}" Text="Volume and audio delay" Margin="0,2,0,0"/>
              </StackPanel>
              <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" Stroke="#FF5B4B" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M4 28V12M16 34V6M28 24V16M40 36V4M52 26V14M64 30V10" Width="68" Height="40" Stretch="None"/>
            </Grid>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource Eyebrow}" Text="PLAYBACK"/>
                <TextBlock Style="{StaticResource CardTitle}" Text="Audio output" Margin="0,2,0,4"/>
                <TextBlock Style="{StaticResource FieldHint}" Margin="0,0,0,16" Text="Controls the player's own output volume."/>
                <Grid Margin="0,0,0,18">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Volume"/><TextBlock Style="{StaticResource FieldHint}" Text="0 is muted and 100 is full volume in the player."/></StackPanel>
                  <StackPanel Grid.Column="1" Width="220" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid>
                      <TextBox x:Name="Volume" Padding="11,0,40,0" AutomationProperties.Name="Volume percent"/>
                      <TextBlock Style="{StaticResource Unit}" Text="%" HorizontalAlignment="Right" Margin="0,0,15,0"/>
                    </Grid>
                    <Slider x:Name="VolumeSlider" Margin="0,10,0,0" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Text, ElementName=Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled, ElementName=Volume}" AutomationProperties.Name="Volume slider"/>
                  </StackPanel>
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Audio buffer"/><TextBlock Style="{StaticResource FieldHint}" Text="0 chooses automatically. Larger values tolerate network variation and increase audio delay."/></StackPanel>
                  <StackPanel Grid.Column="1" Width="220" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid>
                      <TextBox x:Name="AudioBuffer" Padding="11,0,44,0" AutomationProperties.Name="Audio buffer in milliseconds"/>
                      <TextBlock Style="{StaticResource Unit}" Text="ms" HorizontalAlignment="Right" Margin="0,0,13,0"/>
                    </Grid>
                    <Slider x:Name="BufferSlider" Margin="0,10,0,0" Minimum="0" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding Text, ElementName=AudioBuffer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled, ElementName=AudioBuffer}" AutomationProperties.Name="Audio buffer slider"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
            <Border BorderBrush="{StaticResource Signal}" BorderThickness="2,0,0,0" Padding="14,2,0,2" Margin="0,16,0,0">
              <TextBlock Style="{StaticResource Margin}" Text="A smaller buffer reduces the extra audio delay added here and can crackle when the network or PC is busy. Raise it if you hear dropouts."/>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- 05 CONTROLS -->
      <TabItem x:Name="ControlsTab" Header="Controls" Tag="05">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <StackPanel Margin="40,32,34,20" MaxWidth="720" HorizontalAlignment="Left">
            <Grid Margin="0,0,0,24">
              <StackPanel>
                <TextBlock Style="{StaticResource Eyebrow}" Text="CONTROLS"/>
                <TextBlock Style="{StaticResource PageTitle}" Text="Keyboard and mouse" Margin="0,2,0,0"/>
              </StackPanel>
              <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" Stroke="#FF5B4B" StrokeThickness="2" StrokeLineJoin="Round" Data="M10 15H30Q34 15 34 19V27Q34 31 30 31H10Q6 31 6 27V19Q6 15 10 15ZM13 20H17M15 18V22M25 22H29M27 20V24" Width="40" Height="40" Stretch="None"/>
            </Grid>

            <Border BorderBrush="{StaticResource Signal}" BorderThickness="2,0,0,0" Padding="14,2,0,2" Margin="0,0,16,0">
              <TextBlock Style="{StaticResource Margin}" Text="Keys can act as controller buttons while the player is open. Mouse aim turns mouse movement into right stick movement. These settings are used the next time you connect."/>
            </Border>

            <!-- Input basics -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,0">
              <StackPanel>
                <TextBlock Style="{StaticResource Eyebrow}" Text="INPUT BASICS"/>
                <TextBlock Style="{StaticResource CardTitle}" Text="The main switches" Margin="0,2,0,4"/>
                <TextBlock Style="{StaticResource FieldHint}" Margin="0,0,0,16" Text="Start here. Most players only need the mouse aim switch and sensitivity."/>
                <Grid Margin="0,0,0,18">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Keyboard"/><TextBlock Style="{StaticResource FieldHint}" Text="Keys act as controller buttons while the player is open."/></StackPanel>
                  <CheckBox x:Name="KeyboardEnabled" Grid.Column="1" Content="Use keyboard as a controller" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,7,0,0" AutomationProperties.Name="Keyboard as controller"/>
                </Grid>
                <Grid Margin="0,0,0,18">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Mouse aim"/><TextBlock Style="{StaticResource FieldHint}" Text="Moving the mouse steers the right stick."/></StackPanel>
                  <CheckBox x:Name="MouseAim" Grid.Column="1" Content="Use mouse aim" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,7,0,0" AutomationProperties.Name="Mouse aim"/>
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Aim sensitivity"/><TextBlock Style="{StaticResource FieldHint}" Text="Higher values turn mouse movement into stick movement faster."/></StackPanel>
                  <StackPanel Grid.Column="1" Width="320" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <TextBox x:Name="AimSensitivity" AutomationProperties.Name="Aim sensitivity"/>
                    <Slider x:Name="AimSensitivitySlider" Margin="0,10,0,0" Minimum="0.1" Maximum="10" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding Text, ElementName=AimSensitivity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled, ElementName=AimSensitivity}" AutomationProperties.Name="Sensitivity slider"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <!-- Walking -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
              <StackPanel>
                <TextBlock Style="{StaticResource Eyebrow}" Text="WALKING"/>
                <TextBlock Style="{StaticResource CardTitle}" Text="Slow down the left stick" Margin="0,2,0,4"/>
                <TextBlock Style="{StaticResource FieldHint}" Margin="0,0,0,16" Text="Hold the walk key with WASD when a game needs slower movement."/>
                <Grid Margin="0,0,0,18">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Walk key"/><TextBlock Style="{StaticResource FieldHint}" Text="Hold this key to walk instead of run."/></StackPanel>
                  <ComboBox x:Name="WalkKey" Grid.Column="1" Width="280" HorizontalAlignment="Left" VerticalAlignment="Top" AutomationProperties.Name="Walk key"/>
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Walk speed"/><TextBlock Style="{StaticResource FieldHint}" Text="A lower percentage walks more slowly."/></StackPanel>
                  <StackPanel Grid.Column="1" Width="280" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid>
                      <TextBox x:Name="WalkScale" Padding="11,0,40,0" AutomationProperties.Name="Walk speed percent"/>
                      <TextBlock Style="{StaticResource Unit}" Text="%" HorizontalAlignment="Right" Margin="0,0,15,0"/>
                    </Grid>
                    <Slider x:Name="WalkScaleSlider" Margin="0,10,0,0" Minimum="20" Maximum="80" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Text, ElementName=WalkScale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled, ElementName=WalkScale}" AutomationProperties.Name="Walk speed slider"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <!-- Keyboard layout -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
              <StackPanel>
                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Style="{StaticResource Eyebrow}" Text="KEYBOARD LAYOUT"/>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Button bindings" Margin="0,2,0,4"/>
                    <TextBlock Style="{StaticResource FieldHint}" Margin="0" Text="Read-only preview of the key each PS5 button uses. Editing opens the advanced app settings window."/>
                  </StackPanel>
                  <Button x:Name="EditKeyMap" Grid.Column="1" Style="{StaticResource SignalOutline}" Content="Edit key bindings" VerticalAlignment="Top" Margin="16,0,0,0" AutomationProperties.Name="Edit key bindings"/>
                </Grid>
                <UniformGrid x:Name="KeyMapGrid" Columns="2"/>
              </StackPanel>
            </Border>

            <!-- Advanced mouse aim tuning, hidden until asked for -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Style="{StaticResource Eyebrow}" Text="MOUSE AIM"/>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Advanced tuning" Margin="0,2,0,4"/>
                    <TextBlock Style="{StaticResource FieldHint}" Margin="0" Text="Most players can leave these values unchanged."/>
                  </StackPanel>
                  <Button x:Name="AimAdvancedToggle" Grid.Column="1" Content="Show advanced aim tuning" VerticalAlignment="Top" Margin="16,0,0,0" MinWidth="176"/>
                </Grid>
                <StackPanel x:Name="AimAdvancedPanel" Visibility="Collapsed" Margin="0,18,0,0">
                  <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Vertical ratio"/><TextBlock Style="{StaticResource FieldHint}" Text="1 keeps vertical and horizontal speed the same. Higher values make vertical aim faster."/></StackPanel>
                    <StackPanel Grid.Column="1" Width="280" HorizontalAlignment="Left" VerticalAlignment="Top">
                      <TextBox x:Name="AimYRatio" AutomationProperties.Name="Aim vertical ratio"/>
                      <Slider x:Name="AimYRatioSlider" Margin="0,10,0,0" Minimum="0.25" Maximum="4" TickFrequency="0.25" IsSnapToTickEnabled="True" Value="{Binding Text, ElementName=AimYRatio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled, ElementName=AimYRatio}" AutomationProperties.Name="Vertical ratio slider"/>
                    </StackPanel>
                  </Grid>
                  <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Deadzone"/><TextBlock Style="{StaticResource FieldHint}" Text="Adds a small starting stick output so fine movement registers in games with a deadzone."/></StackPanel>
                    <StackPanel Grid.Column="1" Width="280" HorizontalAlignment="Left" VerticalAlignment="Top">
                      <Grid>
                        <TextBox x:Name="AimDeadzone" Padding="11,0,40,0" AutomationProperties.Name="Aim deadzone percent"/>
                        <TextBlock Style="{StaticResource Unit}" Text="%" HorizontalAlignment="Right" Margin="0,0,15,0"/>
                      </Grid>
                      <Slider x:Name="AimDeadzoneSlider" Margin="0,10,0,0" Minimum="0" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Text, ElementName=AimDeadzone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled, ElementName=AimDeadzone}" AutomationProperties.Name="Deadzone slider"/>
                    </StackPanel>
                  </Grid>
                  <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Curve"/><TextBlock Style="{StaticResource FieldHint}" Text="1 is linear. Higher values give finer slow movement while keeping fast movement available."/></StackPanel>
                    <StackPanel Grid.Column="1" Width="280" HorizontalAlignment="Left" VerticalAlignment="Top">
                      <TextBox x:Name="AimCurve" AutomationProperties.Name="Aim curve"/>
                      <Slider x:Name="AimCurveSlider" Margin="0,10,0,0" Minimum="0.3" Maximum="3" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding Text, ElementName=AimCurve, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled, ElementName=AimCurve}" AutomationProperties.Name="Curve slider"/>
                    </StackPanel>
                  </Grid>
                  <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Smoothing window"/><TextBlock Style="{StaticResource FieldHint}" Text="Averages mouse input over this many milliseconds. Lower values react sooner and can feel less steady."/></StackPanel>
                    <StackPanel Grid.Column="1" Width="280" HorizontalAlignment="Left" VerticalAlignment="Top">
                      <Grid>
                        <TextBox x:Name="AimWindow" Padding="11,0,44,0" AutomationProperties.Name="Aim smoothing window milliseconds"/>
                        <TextBlock Style="{StaticResource Unit}" Text="ms" HorizontalAlignment="Right" Margin="0,0,13,0"/>
                      </Grid>
                      <Slider x:Name="AimWindowSlider" Margin="0,10,0,0" Minimum="2" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Text, ElementName=AimWindow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled, ElementName=AimWindow}" AutomationProperties.Name="Smoothing window slider"/>
                    </StackPanel>
                  </Grid>
                  <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Stop easing"/><TextBlock Style="{StaticResource FieldHint}" Text="Eases stick output back to center when mouse movement stops."/></StackPanel>
                    <StackPanel Grid.Column="1" Width="280" HorizontalAlignment="Left" VerticalAlignment="Top">
                      <Grid>
                        <TextBox x:Name="AimTau" Padding="11,0,44,0" AutomationProperties.Name="Aim stop easing milliseconds"/>
                        <TextBlock Style="{StaticResource Unit}" Text="ms" HorizontalAlignment="Right" Margin="0,0,13,0"/>
                      </Grid>
                      <Slider x:Name="AimTauSlider" Margin="0,10,0,0" Minimum="0" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Text, ElementName=AimTau, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled, ElementName=AimTau}" AutomationProperties.Name="Stop easing slider"/>
                    </StackPanel>
                  </Grid>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Release key"/><TextBlock Style="{StaticResource FieldHint}" Text="Press this key or Esc to end mouse capture."/></StackPanel>
                    <ComboBox x:Name="AimRelease" Grid.Column="1" Width="280" HorizontalAlignment="Left" VerticalAlignment="Top" AutomationProperties.Name="Aim release key"/>
                  </Grid>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Local aim preview -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
              <StackPanel>
                <TextBlock Style="{StaticResource Eyebrow}" Text="AIM PREVIEW"/>
                <TextBlock Style="{StaticResource CardTitle}" Text="Try the feel on this PC" Margin="0,2,0,4"/>
                <TextBlock Style="{StaticResource FieldHint}" Margin="0,0,0,14" Text="The graph shows stick output for mouse speed using the current draft values. The jump at the left edge is the deadzone floor."/>
                <Canvas x:Name="ResponseGraph" Height="150" Margin="0,0,0,14"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Canvas x:Name="AimPad" Width="190" Height="190" Background="Transparent"/>
                  <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Muted}" Text="LOCAL AIM TEST"/>
                    <TextBlock x:Name="AimSpeed" FontFamily="{StaticResource Mono}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Paper}" Margin="0,8,0,0"/>
                    <TextBlock x:Name="AimStick" FontFamily="{StaticResource Mono}" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                    <TextBlock Style="{StaticResource Margin}" FontSize="12" Margin="0,12,0,0" Text="Click the pad to capture the mouse. Esc or the release key ends it. Input stays on this PC."/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <Border BorderBrush="{StaticResource Signal}" BorderThickness="2,0,0,0" Padding="14,2,0,2" Margin="0,16,0,0">
              <TextBlock Style="{StaticResource Margin}" Text="Keyboard, walking and mouse settings are used the next time you connect. The aim pad is a local preview only and never sends input to the PS5."/>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

    </TabControl>

    <!-- Presentation mode switch, deliberately outside the tab template so the controller can own it -->
    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="224" Height="88" Margin="0,0,0,72" Background="{StaticResource Rail}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,13">
      <StackPanel>
        <Grid>
          <TextBlock Text="VIEW" FontFamily="{StaticResource Mono}" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
          <TextBlock x:Name="ModeCaption" Text="Essentials only" FontSize="12" Foreground="{StaticResource Paper}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
        <Button x:Name="ModeToggle" Style="{StaticResource SignalOutline}" Content="Show advanced" Margin="0,9,0,0" Height="34" MinWidth="0" Width="150" HorizontalAlignment="Left"/>
      </StackPanel>
    </Border>

    <!-- Shared footer: draft actions and the latest result -->
    <Border VerticalAlignment="Bottom" Height="76" Margin="224,0,0,0" Background="#0F0E0D" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
      <Grid Margin="40,0,34,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Center" MaxHeight="56" Margin="0,0,18,0" Focusable="False">
          <TextBlock x:Name="Notice" Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" LineHeight="18" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </ScrollViewer>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="Revert" Content="Reset to saved" Margin="0,0,10,0" MinWidth="128"/>
          <Button x:Name="Apply" Style="{StaticResource Accent}" Content="Save settings" MinWidth="128"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
