+void QmlMainWindow::updateColorHook()
+{
+    const double saturation = settings->GetColorSaturation();
+    const double vibrance = settings->GetColorVibrance();
+    const double contrast = settings->GetColorContrast();
+    const double brightness = settings->GetColorBrightness();
+    const double temperature = settings->GetColorTemperature();
+    const double tint = settings->GetColorTint();
+    if (color_hook
+            && color_grade_saturation == saturation && color_grade_vibrance == vibrance
+            && color_grade_contrast == contrast && color_grade_brightness == brightness
+            && color_grade_temperature == temperature && color_grade_tint == tint)
+        return;
+    if (color_hook)
+    {
+        pl_mpv_user_shader_destroy(&color_hook);
+        color_hook = nullptr;
+    }
+    color_grade_saturation = saturation;
+    color_grade_vibrance = vibrance;
+    color_grade_contrast = contrast;
+    color_grade_brightness = brightness;
+    color_grade_temperature = temperature;
+    color_grade_tint = tint;
+    const bool neutral = saturation == 1.0 && vibrance == 0.0 && contrast == 1.0
+            && brightness == 0.0 && temperature == 0.0 && tint == 0.0;
+    if (neutral)
+        return;
+    const auto num = [](double v) { return QString::number(v, 'f', 6); };
+    const QString src = QStringLiteral(
+        "//!HOOK OUTPUT\n"
+        "//!BIND HOOKED\n"
+        "//!DESC Vectis color grade\n"
+        "\n"
+        "vec4 hook()\n"
+        "{\n"
+        "    vec4 c = HOOKED_tex(HOOKED_pos);\n"
+        "    vec3 rgb = clamp(c.rgb, 0.0, 1.0);\n"
+        "    rgb.r *= 1.0 + %1 * 0.15;\n"
+        "    rgb.b *= 1.0 - %1 * 0.15;\n"
+        "    rgb.g *= 1.0 - %2 * 0.15;\n"
+        "    rgb += vec3(%3);\n"
+        "    rgb = clamp(rgb, 0.0, 1.0);\n"
+        "    rgb = (rgb - 0.5) * %4 + 0.5;\n"
+        "    rgb = clamp(rgb, 0.0, 1.0);\n"
+        "    float luma = dot(rgb, vec3(0.2126, 0.7152, 0.0722));\n"
+        "    rgb = mix(vec3(luma), rgb, clamp(%5, 0.0, 4.0));\n"
+        "    rgb = clamp(rgb, 0.0, 1.0);\n"
+        "    float mx = max(rgb.r, max(rgb.g, rgb.b));\n"
+        "    float mn = min(rgb.r, min(rgb.g, rgb.b));\n"
+        "    float chroma = clamp(mx - mn, 0.0, 1.0);\n"
+        "    luma = dot(rgb, vec3(0.2126, 0.7152, 0.0722));\n"
+        "    rgb = mix(vec3(luma), rgb, clamp(1.0 + %6 * (1.0 - chroma), 0.0, 4.0));\n"
+        "    c.rgb = clamp(rgb, 0.0, 1.0);\n"
+        "    return c;\n"
+        "}\n")
+        .arg(num(temperature)).arg(num(tint)).arg(num(brightness))
+        .arg(num(contrast)).arg(num(saturation)).arg(num(vibrance));
+    const QByteArray bytes = src.toUtf8();
+    color_hook = pl_mpv_user_shader_parse(placeboGpu(), bytes.constData(), static_cast<size_t>(bytes.size()));
+    if (!color_hook)
+        qCWarning(chiakiGui) << "Failed to parse color grade shader";
+}
