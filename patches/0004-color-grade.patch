+{
+	return qBound(0.0, settings.value("settings/color_saturation", 1.0).toDouble(), 2.0);
+}
+
+double Settings::GetColorVibrance() const
+{
+	return qBound(-1.0, settings.value("settings/color_vibrance", 0.0).toDouble(), 1.0);
+}
+
+double Settings::GetColorContrast() const
+{
+	return qBound(0.5, settings.value("settings/color_contrast", 1.0).toDouble(), 2.0);
+}
+
+double Settings::GetColorBrightness() const
+{
+	return qBound(-0.5, settings.value("settings/color_brightness", 0.0).toDouble(), 0.5);
+}
+
+double Settings::GetColorTemperature() const
