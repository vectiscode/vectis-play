+#ifdef _WIN32
+void StreamSession::SetMouseAimState(int16_t x, int16_t y, Qt::MouseButtons buttons)
+{
+	const uint8_t r2 = buttons.testFlag(Qt::LeftButton) ? 255 : 0;
+	const uint8_t l2 = buttons.testFlag(Qt::RightButton) ? 255 : 0;
+	const uint32_t r3 = buttons.testFlag(Qt::MiddleButton) ? CHIAKI_CONTROLLER_BUTTON_R3 : 0;
+	if(mouse_state.right_x == x && mouse_state.right_y == y && mouse_state.r2_state == r2
+			&& mouse_state.l2_state == l2 && mouse_state.buttons == r3)
+		return;
+	mouse_state.right_x = x;
+	mouse_state.right_y = y;
