+		const MouseAimConfig config;
+		bool captured = false, released = false, blocked = false;
+		Qt::MouseButtons buttons;
+		QTimer pace_timer;
+		qint64 window_ticks, last_motion = 0;
+		double tau_ticks;
+		bool engaged = false;
+		double target_x = 0.0, target_y = 0.0;
+		qint16 sent_x = 0, sent_y = 0;
+		struct Sample { qint64 t; long dx, dy; };
+		std::vector<Sample> ring;
+		size_t head = 0, count = 0;
+		qint64 sum_x = 0, sum_y = 0;
+};
+#endif
