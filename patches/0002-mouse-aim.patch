diff --git a/gui/src/mouseaim.cpp b/gui/src/mouseaim.cpp
new file mode 100644
index 0000000..bcf8bd8
--- /dev/null
+++ b/gui/src/mouseaim.cpp
@@ -0,0 +1,254 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+
+#include "mouseaim.h"
+
+#ifdef _WIN32
+#include "streamsession.h"
+
+#include <QGuiApplication>
+#include <QKeyEvent>
+#include <QWindow>
+#include <qt_windows.h>
+#include <algorithm>
+#include <cmath>
+
+static bool ClipToClient(HWND hwnd)
+{
+	RECT rect;
+	POINT origin = {};
+	return GetClientRect(hwnd, &rect) && !IsRectEmpty(&rect)
+		&& ClientToScreen(hwnd, &origin) && OffsetRect(&rect, origin.x, origin.y)
+		&& ClipCursor(&rect);
+}
+
+static qint64 CounterNow()
+{
+	LARGE_INTEGER now;
+	QueryPerformanceCounter(&now);
+	return now.QuadPart;
+}
+
+MouseAim::MouseAim(QWindow &window, StreamSession &session)
+	: window(window), session(&session), config(session.mouse_aim_config), ring(64)
+{
+	LARGE_INTEGER frequency;
+	QueryPerformanceFrequency(&frequency);
+	window_ticks = (frequency.QuadPart * config.window_ms + 999) / 1000;
+	tau_ticks = frequency.QuadPart * (config.stop_tau_ms / 1000.0);
+	pace_timer.setSingleShot(true);
+	pace_timer.setTimerType(Qt::PreciseTimer);
+	pace_timer.setInterval(2);
+	connect(&pace_timer, &QTimer::timeout, this, [this]() { Flush(CounterNow()); });
+	window.installEventFilter(this);
+	qGuiApp->installNativeEventFilter(this);
+	window.setCursor(Qt::ArrowCursor);
+	Capture();
+}
+
+MouseAim::~MouseAim()
+{
+	qGuiApp->removeNativeEventFilter(this);
+	window.removeEventFilter(this);
+	Release();
+}
+
+void MouseAim::Capture()
+{
+	if(captured || blocked || !window.isActive())
+		return;
+	const HWND hwnd = reinterpret_cast<HWND>(window.winId());
+	if(GetForegroundWindow() != hwnd)
+		return;
+	const RAWINPUTDEVICE mouse = {0x01, 0x02, 0, hwnd};
+	if(!RegisterRawInputDevices(&mouse, 1, sizeof(mouse)))
+	{
+		qWarning("Mouse aim: RegisterRawInputDevices failed (%lu)", GetLastError());
+		return;
+	}
+	captured = true;
+	if(!ClipToClient(hwnd))
+	{
+		Release();
+		return;
+	}
+	released = false;
+	window.setCursor(Qt::BlankCursor);
+}
+
+void MouseAim::Release()
+{
+	released = true;
+	if(!captured)
+		return;
+	captured = false;
+	const RAWINPUTDEVICE mouse = {0x01, 0x02, RIDEV_REMOVE, nullptr};
+	if(!RegisterRawInputDevices(&mouse, 1, sizeof(mouse)))
+		qWarning("Mouse aim: raw input removal failed (%lu)", GetLastError());
+	ClipCursor(nullptr);
+	window.setCursor(Qt::ArrowCursor);
+	pace_timer.stop();
+	buttons = {};
+	engaged = false;
+	head = count = 0;
+	sum_x = sum_y = 0;
+	target_x = target_y = 0.0;
+	sent_x = sent_y = 0;
+	if(session)
+		session->SetMouseAimState(0, 0, buttons);
+}
+
+void MouseAim::SetBlocked(bool block)
+{
+	blocked = block;
+	if(block)
+		Release();
+}
+
+bool MouseAim::eventFilter(QObject *, QEvent *event)
+{
+	switch(event->type())
+	{
+		case QEvent::FocusIn:
+		case QEvent::WindowActivate:
+			if(!released)
+				Capture();
+			break;
+		case QEvent::FocusOut:
+		case QEvent::WindowDeactivate:
+		case QEvent::Hide:
+			Release();
+			break;
+		case QEvent::Move:
+		case QEvent::Resize:
+			if(captured && !ClipToClient(reinterpret_cast<HWND>(window.winId())))
+				Release();
+			break;
+		case QEvent::ShortcutOverride:
+		case QEvent::KeyPress:
+		case QEvent::KeyRelease:
+			if(!blocked && static_cast<QKeyEvent *>(event)->key() == config.release_key)
+			{
+				if(event->type() == QEvent::KeyPress)
+					Release();
+				event->accept();
+				return true;
+			}
+			break;
+		case QEvent::MouseButtonPress:
+		case QEvent::MouseButtonDblClick:
+			if(!blocked && static_cast<QMouseEvent *>(event)->source() == Qt::MouseEventNotSynthesized)
+				Capture();
+			[[fallthrough]];
+		case QEvent::MouseMove:
+		case QEvent::MouseButtonRelease:
+			// The recapture click and legacy mouse events must not become touchpad input.
+			return !blocked;
+		default:
+			break;
+	}
+	return false;
+}
+
+bool MouseAim::nativeEventFilter(const QByteArray &type, void *message, qintptr *)
+{
+	const MSG *msg = static_cast<const MSG *>(message);
+	if(!captured || msg->message != WM_INPUT || type != "windows_generic_MSG"
+			|| msg->hwnd != reinterpret_cast<HWND>(window.winId()) || !session)
+		return false;
+	if(GetForegroundWindow() != msg->hwnd)
+	{
+		Release();
+		return false;
+	}
+
+	const qint64 now = CounterNow();
+	RAWINPUT raw;
+	UINT size = sizeof(raw);
+	if(GetRawInputData(reinterpret_cast<HRAWINPUT>(msg->lParam), RID_INPUT, &raw, &size,
+				sizeof(RAWINPUTHEADER)) != sizeof(raw) || raw.header.dwType != RIM_TYPEMOUSE)
+		return false;
+	const RAWMOUSE &mouse = raw.data.mouse;
+	// MOUSE_MOVE_RELATIVE is zero. Other flags can accompany relative movement.
+	if(mouse.usFlags & MOUSE_MOVE_ABSOLUTE)
+		return false;
+	const USHORT flags = mouse.usButtonFlags;
+	const auto previous_buttons = buttons;
+	if(flags & RI_MOUSE_LEFT_BUTTON_DOWN) buttons |= Qt::LeftButton;
+	if(flags & RI_MOUSE_LEFT_BUTTON_UP) buttons &= ~Qt::LeftButton;
+	if(flags & RI_MOUSE_RIGHT_BUTTON_DOWN) buttons |= Qt::RightButton;
+	if(flags & RI_MOUSE_RIGHT_BUTTON_UP) buttons &= ~Qt::RightButton;
+	if(flags & RI_MOUSE_MIDDLE_BUTTON_DOWN) buttons |= Qt::MiddleButton;
+	if(flags & RI_MOUSE_MIDDLE_BUTTON_UP) buttons &= ~Qt::MiddleButton;
+	if(mouse.lLastX || mouse.lLastY)
+		Update(now, mouse.lLastX, mouse.lLastY);
+	if(!pace_timer.isActive())
+		Flush(now, buttons != previous_buttons);
+	else if(buttons != previous_buttons)
+		session->SetMouseAimState(sent_x, sent_y, buttons);
+	return false; // Let Qt and DefWindowProc finish processing foreground WM_INPUT.
+}
+
+void MouseAim::Update(qint64 now, long dx, long dy)
+{
+	last_motion = now;
+	while(count && now - ring[head].t >= window_ticks)
+	{
+		sum_x -= ring[head].dx;
+		sum_y -= ring[head].dy;
+		head = (head + 1) % ring.size();
+		--count;
+	}
+	if(count == ring.size())
+	{
+		std::rotate(ring.begin(), ring.begin() + head, ring.end());
+		ring.resize(count * 2);
+		head = 0;
+	}
+	ring[(head + count++) % ring.size()] = {now, dx, dy};
+	sum_x += dx;
+	sum_y += dy;
+
+	const double y = sum_y * config.y_ratio;
+	const double length = std::hypot(double(sum_x), y);
+	const double gain = config.sensitivity / (4.0 * config.window_ms);
+	const double m = std::min(1.0, length * std::abs(gain));
+	// Gate on velocity before the curve and anti-deadzone lift quiet input.
+	engaged = m >= (engaged ? 0.01 : 0.03);
+	double scale = 0.0;
+	if(engaged)
+		scale = std::copysign(1.0, gain) * (config.deadzone + (1.0 - config.deadzone)
+				* std::pow(m, config.curve)) / length;
+	// SDL right Y is negative for up, the same sign as relative mouse Y.
+	target_x = sum_x * scale;
+	target_y = y * scale;
+}
+
+void MouseAim::Flush(qint64 now, bool button_edge)
+{
+	if(!captured || !session)
+		return;
+	double fade = 1.0;
+	const qint64 tail = now - last_motion - window_ticks;
+	if(engaged && tail >= 0)
+	{
+		fade = tau_ticks > 0.0 ? std::exp(-tail / tau_ticks) : 0.0;
+		if(std::hypot(target_x, target_y) * fade < 0.01)
+		{
+			engaged = false;
+			target_x = target_y = 0.0;
+		}
+	}
+	const qint16 x = std::lround(32767.0 * target_x * fade);
+	const qint16 y = std::lround(32767.0 * target_y * fade);
+	const bool changed = x != sent_x || y != sent_y;
+	if(changed || button_edge)
+	{
+		sent_x = x;
+		sent_y = y;
+		session->SetMouseAimState(x, y, buttons);
+	}
+	// One last interval after publishing zero keeps a quick restart within 500 Hz.
+	if(engaged || changed)
+		pace_timer.start();
+}
+#endif
